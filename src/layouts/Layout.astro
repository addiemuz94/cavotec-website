---
import CavotecLogo from '../assets/cavotec-logo.svg';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Cavotec Malaysia',
	description = 'Cavotec Malaysia Sdn Bhd — connection and electrification solutions.',
} = Astro.props;

// Footer "Quick Links": top-level pages stay flat, but Services/Products
// mirror the full "Our Business" structure below (same ourBusinessMenu data)
// so the footer and the nav mega-menu never drift out of sync.
const footerCompanyLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/our-company', label: 'Our Company' },
	{ href: '/case-studies', label: 'Case Studies' },
	{ href: '/contact', label: 'Contact' },
];

// Header nav: Services and Products are merged into a single "Our Business"
// two-column mega menu instead of two standalone top-level links.
const ourBusinessMenu = [
	{
		title: 'Services',
		href: '/services',
		items: [
			{ href: '/services#calibration', label: 'Calibration' },
			{ href: '/services#repair-work', label: 'Repair Work' },
			{ href: '/services#equipment-rental', label: 'Equipment Rental' },
			{ href: '/services#training', label: 'Training' },
			{
				href: '/services#customize-solution-provider',
				label: 'Customize Solution Provider',
				children: [
					{ href: '/services#electronic-design-service', label: 'Electronic Design Service' },
					{ href: '/services#3d-design-service', label: '3D Design Service' },
					{ href: '/services#new-product-rd-innovation', label: 'New Product R&D and Innovation' },
				],
			},
		],
	},
	{
		title: 'Products',
		href: '/products',
		items: [
			{
				href: '/products#calibration-test-equipment-automation',
				label: 'Calibration and Test Equipment Automation',
			},
			{
				href: '/products#internet-of-things-iot',
				label: 'Internet of Things (IoT)',
				children: [
					{ href: 'https://kms-cvt.com', label: 'Smart Key Management System (eKMS)', external: true },
					{ href: '/products#integrated-alarm-system', label: 'Integrated Alarm System' },
					{
						href: '/products#smart-building-management-monitoring-system',
						label: 'Smart Building Management and Monitoring System (BMS)',
					},
				],
			},
		],
	},
];

const headerNavLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/our-company', label: 'Our Company' },
	{ label: 'Our Business', megaMenu: ourBusinessMenu },
	{ href: '/case-studies', label: 'Case Studies' },
	{ href: '/contact', label: 'Contact' },
];

const socialLinks = [
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/company/cavotec', icon: 'linkedin' },
	{ label: 'Facebook', href: 'https://www.facebook.com/cavotec', icon: 'facebook' },
	{ label: 'X (Twitter)', href: 'https://twitter.com/cavotec', icon: 'x' },
	{ label: 'YouTube', href: 'https://www.youtube.com/cavotec', icon: 'youtube' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0A0A0C" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="header-inner">
				<a href="/" class="logo" aria-label="Cavotec home">
					<img src={CavotecLogo.src} alt="Cavotec" width="150" height="34" />
				</a>

				<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
				<label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation menu">
					<span></span>
					<span></span>
					<span></span>
				</label>

				<nav class="site-nav" aria-label="Main navigation">
					<ul>
						{headerNavLinks.map((link) =>
							link.megaMenu ? (
								<li class="has-dropdown">
									<button
										type="button"
										class="dropdown-toggle"
										aria-expanded="false"
										aria-haspopup="true"
										aria-controls="our-business-menu"
									>
										{link.label}
										<svg class="chevron-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M6 9l6 6 6-6" />
										</svg>
									</button>
									<div class="dropdown-panel mega-menu-panel" id="our-business-menu">
										<div class="mega-menu-columns">
											{link.megaMenu.map((column) => (
												<div class="mega-menu-column">
													<a href={column.href} class="mega-menu-column-title">{column.title}</a>
													<ul>
														{column.items.map((item) => (
															<li class={item.children ? 'has-subitems' : undefined}>
																<a href={item.href}>{item.label}</a>
																{item.children && (
																	<ul class="dropdown-subitems">
																		{item.children.map((child) => (
																			<li>
																				<a
																					href={child.href}
																					target={child.external ? '_blank' : undefined}
																					rel={child.external ? 'noopener noreferrer' : undefined}
																					aria-label={child.external ? `${child.label} (opens in a new tab)` : undefined}
																				>
																					{child.label}
																					{child.external && (
																						<svg class="external-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
																							<path d="M7 17L17 7" />
																							<path d="M8 7h9v9" />
																						</svg>
																					)}
																				</a>
																			</li>
																		))}
																	</ul>
																)}
															</li>
														))}
													</ul>
												</div>
											))}
										</div>
									</div>
								</li>
							) : (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							)
						)}
					</ul>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<img src={CavotecLogo.src} alt="Cavotec" width="140" height="32" class="footer-logo" />
					<p>Connection and electrification solutions for ports, airports and industry.</p>
				</div>

				<div class="footer-link-groups">
					<nav class="footer-nav" aria-label="Footer navigation">
						<ul>
							{footerCompanyLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))}
						</ul>
					</nav>

					{ourBusinessMenu.map((column) => (
						<nav class="footer-nav footer-business-group" aria-label={`${column.title} links`}>
							<a href={column.href} class="footer-group-title">{column.title}</a>
							<ul>
								{column.items.map((item) => (
									<li class={item.children ? 'has-subitems' : undefined}>
										<a href={item.href}>{item.label}</a>
										{item.children && (
											<ul class="footer-subitems">
												{item.children.map((child) => (
													<li>
														<a
															href={child.href}
															target={child.external ? '_blank' : undefined}
															rel={child.external ? 'noopener noreferrer' : undefined}
															aria-label={child.external ? `${child.label} (opens in a new tab)` : undefined}
														>
															{child.label}
															{child.external && (
																<svg class="external-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
																	<path d="M7 17L17 7" />
																	<path d="M8 7h9v9" />
																</svg>
															)}
														</a>
													</li>
												))}
											</ul>
										)}
									</li>
								))}
							</ul>
						</nav>
					))}
				</div>

				<div class="footer-social">
					<span class="footer-social-title">Follow us</span>
					<ul>
						{socialLinks.map((social) => (
							<li>
								<a href={social.href} aria-label={social.label} target="_blank" rel="noopener noreferrer">
									{social.icon === 'linkedin' && (
										<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
											<path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.25h4.5V23h-4.5V8.25zM8.5 8.25h4.31v2.01h.06c.6-1.14 2.07-2.35 4.26-2.35 4.56 0 5.4 3 5.4 6.9V23h-4.5v-6.77c0-1.62-.03-3.7-2.25-3.7-2.26 0-2.6 1.76-2.6 3.58V23h-4.5V8.25z"/>
										</svg>
									)}
									{social.icon === 'facebook' && (
										<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
											<path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z"/>
										</svg>
									)}
									{social.icon === 'x' && (
										<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
											<path d="M18.9 2H22l-7.6 8.68L23 22h-6.9l-5.4-6.86L4.6 22H1.5l8.13-9.29L1 2h7.1l4.88 6.27L18.9 2zm-1.2 18h1.7L6.4 4h-1.8l13.1 16z"/>
										</svg>
									)}
									{social.icon === 'youtube' && (
										<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
											<path d="M23.5 6.5s-.23-1.64-.94-2.36c-.9-.94-1.9-.95-2.36-1C16.9 3 12 3 12 3h-.01s-4.89 0-8.19.14c-.46.05-1.46.06-2.36 1C.73 4.86.5 6.5.5 6.5S.27 8.42.27 10.34v1.8c0 1.92.23 3.84.23 3.84s.23 1.64.94 2.36c.9.94 2.09.91 2.62 1.01C6 19.5 12 19.55 12 19.55s4.9-.01 8.2-.15c.46-.06 1.46-.07 2.36-1.01.71-.72.94-2.36.94-2.36s.23-1.92.23-3.84v-1.8c0-1.92-.23-3.84-.23-3.84zM9.75 14.85V8.66l6 3.1-6 3.09z"/>
										</svg>
									)}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>

			<div class="footer-bottom">
				<p>Copyright &copy; Cavotec Malaysia Sdn Bhd 2026. All Rights Reserved.</p>
			</div>
		</footer>
	</body>
</html>

<script>
	// Lightweight scroll-reveal: progressive enhancement only.
	// If JS never runs, or the user prefers reduced motion, [data-reveal]
	// elements stay at full opacity (see the CSS default in the global
	// stylesheet) — nothing ever gets stuck hidden.
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!prefersReducedMotion && 'IntersectionObserver' in window) {
		document.documentElement.classList.add('reveal-enabled');

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
		);

		document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
	}

	// Subtle scroll-based depth for hero/page-header/closing-CTA background
	// grid textures (marked with [data-parallax-bg]) — the background drifts
	// at a fraction of scroll speed, so it lags slightly behind the
	// foreground content instead of scrolling in lockstep. Disabled for
	// reduced motion and on touch/narrow-viewport devices, where scroll-
	// linked transforms tend to read as janky rather than smooth.
	const parallaxEls = document.querySelectorAll('[data-parallax-bg]');
	const isCoarsePointer = window.matchMedia('(pointer: coarse)').matches;
	const isNarrowViewport = window.innerWidth <= 768;

	if (!prefersReducedMotion && !isCoarsePointer && !isNarrowViewport && parallaxEls.length) {
		let parallaxTicking = false;

		const updateParallax = () => {
			parallaxEls.forEach((el) => {
				const parent = el.parentElement;
				if (!parent) return;
				const offset = parent.getBoundingClientRect().top * 0.12;
				el.style.transform = `translate3d(0, ${offset}px, 0)`;
			});
			parallaxTicking = false;
		};

		const onParallaxScroll = () => {
			if (!parallaxTicking) {
				requestAnimationFrame(updateParallax);
				parallaxTicking = true;
			}
		};

		window.addEventListener('scroll', onParallaxScroll, { passive: true });
		window.addEventListener('resize', onParallaxScroll, { passive: true });
		updateParallax();
	}

	// "Our Business" nav mega menu: click/tap toggle (desktop also opens on
	// hover/focus via CSS alone). This click handler is what makes it work as
	// an expandable accordion on mobile, where there is no hover.
	document.querySelectorAll('.dropdown-toggle').forEach((toggle) => {
		const parent = toggle.closest('.has-dropdown');
		if (!parent) return;

		toggle.addEventListener('click', () => {
			const isOpen = parent.classList.toggle('is-open');
			toggle.setAttribute('aria-expanded', String(isOpen));
		});
	});

	document.addEventListener('click', (event) => {
		document.querySelectorAll('.has-dropdown.is-open').forEach((el) => {
			if (el.contains(event.target)) return;
			el.classList.remove('is-open');
			el.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		document.querySelectorAll('.has-dropdown.is-open').forEach((el) => {
			el.classList.remove('is-open');
			const toggle = el.querySelector('.dropdown-toggle');
			if (toggle instanceof HTMLElement) {
				toggle.setAttribute('aria-expanded', 'false');
				toggle.focus();
			}
		});
	});

	// Card shine — single shared utility for every [data-shine] card
	// site-wide (service/product/pillar/IoT/customize/case-study cards all
	// carry it alongside .tech-card). Tracks the cursor position within the
	// card as a 0–100% coordinate and writes it to --shine-x/--shine-y; the
	// CSS above (registered via @property) handles rendering the gradient
	// and smoothly transitioning --shine-opacity on its own — this only
	// ever sets target values, never animates anything itself.
	const ACTIVE_SHINE_OPACITY = '0.15';

	function updateShinePosition(card: HTMLElement, event: PointerEvent) {
		const rect = card.getBoundingClientRect();
		const x = Math.min(100, Math.max(0, ((event.clientX - rect.left) / rect.width) * 100));
		const y = Math.min(100, Math.max(0, ((event.clientY - rect.top) / rect.height) * 100));
		card.style.setProperty('--shine-x', `${x}%`);
		card.style.setProperty('--shine-y', `${y}%`);
	}

	if (!prefersReducedMotion) {
		document.querySelectorAll<HTMLElement>('[data-shine]').forEach((card) => {
			card.addEventListener('pointermove', (event) => updateShinePosition(card, event), { passive: true });

			card.addEventListener(
				'pointerenter',
				(event) => {
					updateShinePosition(card, event);
					card.style.setProperty('--shine-opacity', ACTIVE_SHINE_OPACITY);
				},
				{ passive: true }
			);

			card.addEventListener(
				'pointerleave',
				() => {
					card.style.setProperty('--shine-opacity', '0');
				},
				{ passive: true }
			);
		});
	}
	// If motion is reduced, [data-shine] elements never get these listeners
	// — the CSS reduced-motion rule instead shows a fixed, faint, centered
	// glow (see [data-shine] in the global styles), never one that tracks
	// the pointer.
</script>

<style is:global>
	/*
	 * Shared design-system primitives used across every page:
	 * tokens, type scale, the tick/ruled-grid motif, scroll reveal,
	 * and the "tech-card" hover treatment (teal glow + calibration
	 * corner brackets). Page-specific layout lives in each page's
	 * own scoped <style> block.
	 */
	:root {
		/* Base — premium black theme. "Indigo" names are kept so every
		   existing var(--color-indigo*) reference (page-header gradients,
		   button text, badge tints, …) repaints automatically; only the
		   values changed, from navy to near-black. */
		--color-indigo: #0a0a0c;
		--color-indigo-rgb: 10, 10, 12;
		--color-indigo-dark: #000000;
		--color-surface: #16161a;
		/* Gradient's lighter stop reuses the elevated-surface tone, so
		   page-header/hero banners fade toward the same tone their cards
		   and panels sit on. */
		--color-indigo-light: var(--color-surface);
		/* Hairline border for dark surfaces — tick-marks, dividers, card
		   borders — used instead of translucent-white/black tricks so
		   separation reads crisp against pure black. */
		--color-border-dark: #26262c;

		/* Accents (unchanged) */
		--color-teal: #00c2d1;
		--color-teal-rgb: 0, 194, 209;
		--color-amber: #f2a950;
		--color-amber-dark: #d98f36;
		--color-amber-rgb: 242, 169, 80;

		/* Text on dark/black surfaces */
		--color-ink: #f2f3f5;
		--color-ink-muted: #8a8f98;

		/* Surfaces & text — the whole site is dark now, so these generic
		   names (still used by every page's card/section CSS) are repointed
		   at the black-theme tokens instead of holding their own light
		   values: --color-bg-alt (was #f7f8fa, the "page" tone) now IS the
		   base black, --color-bg (was #ffffff, the "card" tone) now IS the
		   elevated surface, and text/border follow the same logic. Nothing
		   in the site ever again resolves to an actual light color. */
		--color-bg: var(--color-surface);
		--color-bg-alt: var(--color-indigo);
		--color-text: var(--color-ink);
		--color-text-muted: var(--color-ink-muted);
		--color-border: var(--color-border-dark);

		/* var(--color-teal-dark, #018b96) is used ~9 times across the pages
		   as a muted-teal accent tuned for light backgrounds; defining it
		   here (rather than editing every call site) makes all of them
		   resolve to the brighter base teal, which is what reads on black. */
		--color-teal-dark: var(--color-teal);

		/* Back-compat aliases so every existing var(--color-navy/--color-accent, …)
		   reference across the site picks up the new palette automatically. */
		--color-navy: var(--color-indigo);
		--color-navy-dark: var(--color-indigo-dark);
		--color-accent: var(--color-teal);

		/* Type */
		--font-display: 'Space Grotesk', 'Segoe UI', system-ui, sans-serif;
		--font-body: 'Inter', 'Segoe UI', system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
		--font-mono: 'IBM Plex Mono', 'Consolas', 'SFMono-Regular', monospace;

		--max-width: 1200px;
		--header-height: 76px;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		font-family: var(--font-body);
		color: var(--color-text);
		background: var(--color-bg-alt);
	}

	main {
		flex: 1;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-family: var(--font-display);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	::selection {
		background: rgba(var(--color-teal-rgb), 0.25);
		color: var(--color-indigo);
	}

	/* ---------------------------------------------------------------- */
	/* Monospace "instrument readout" treatment for numbers, badges,     */
	/* category tags and specs.                                         */
	/* ---------------------------------------------------------------- */
	.spec-mono {
		font-family: var(--font-mono);
		letter-spacing: 0.02em;
		font-variant-numeric: tabular-nums;
	}

	/* ---------------------------------------------------------------- */
	/* Tick-mark / ruled-scale divider — a section boundary that reads   */
	/* like a measurement scale instead of a plain border line.          */
	/* ---------------------------------------------------------------- */
	.tick-divider {
		width: 100%;
		height: 22px;
		background-image:
			repeating-linear-gradient(
				90deg,
				var(--color-border) 0,
				var(--color-border) 1px,
				transparent 1px,
				transparent 14px
			),
			repeating-linear-gradient(
				90deg,
				rgba(var(--color-teal-rgb), 0.55) 0,
				rgba(var(--color-teal-rgb), 0.55) 1.5px,
				transparent 1.5px,
				transparent 70px
			);
		background-repeat: repeat-x, repeat-x;
		background-position: center, center;
		background-size: auto 9px, auto 16px;
	}

	/* ---------------------------------------------------------------- */
	/* Scroll reveal. Default state = fully visible, so content never    */
	/* disappears without JS. Only once .reveal-enabled is set on <html> */
	/* (JS ran + motion is allowed) do elements start hidden and animate */
	/* in as they cross the viewport.                                    */
	/*                                                                    */
	/* .reveal-enabled and .is-visible are wrapped in :where(...), which  */
	/* matches identically but always contributes zero to specificity.    */
	/* Without it, the settled-state rule below was                      */
	/* html.reveal-enabled [data-reveal].is-visible — specificity (0,3,1) */
	/* — which permanently beat any hover/focus rule with fewer than 3    */
	/* classes (e.g. .tech-card:hover's translateY(-4px) lift, or         */
	/* .btn-accent:hover's translateY(-2px), both (0,2,0)) on any element */
	/* that also happens to carry [data-reveal], silently killing those   */
	/* hover states once the card/button had scrolled into view and       */
	/* settled. Keeping `html` and `[data-reveal]` outside :where() still */
	/* gives this rule (0,1,1) — just enough to keep beating the plain    */
	/* (0,1,0) base/pre-reveal rules below and above it, so the reveal    */
	/* animation itself is untouched, while any interactive :hover/       */
	/* :focus rule (2+ classes) now correctly wins afterward. */
	[data-reveal] {
		opacity: 1;
		transform: none;
	}

	html:where(.reveal-enabled) [data-reveal] {
		opacity: 0;
		transform: translateY(22px);
		transition: opacity 0.7s ease, transform 0.7s ease;
		transition-delay: calc(var(--reveal-i, 0) * 70ms);
	}

	html:where(.reveal-enabled) [data-reveal]:where(.is-visible) {
		opacity: 1;
		transform: none;
	}

	/* ---------------------------------------------------------------- */
	/* Card shine: a soft radial highlight that tracks the cursor within */
	/* any [data-shine] card (every .tech-card site-wide — service,      */
	/* product, IoT, case-study and "customize" cards all carry both).   */
	/* Registering these as typed custom properties lets the browser     */
	/* smoothly interpolate --shine-opacity on its own via a plain CSS   */
	/* transition — no rAF loop needed, only the JS below setting the    */
	/* target values on pointer events (see the script's CardShine bit). */
	/* ---------------------------------------------------------------- */
	@property --shine-x {
		syntax: '<percentage>';
		inherits: true;
		initial-value: 50%;
	}

	@property --shine-y {
		syntax: '<percentage>';
		inherits: true;
		initial-value: 50%;
	}

	@property --shine-opacity {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	/* Implemented as an extra background-image layer, not a ::before/
	   ::after pseudo-element: .tech-card already spends both pseudo-
	   element slots on its corner-bracket marks (below), and a
	   background layer sidesteps z-index/stacking entirely — backgrounds
	   always paint behind an element's own content by definition, so
	   this can never cover the card's text/icons no matter what, and it
	   composes with the corner brackets (z-index: 2) and hover glow
	   without any extra stacking-context work. --shine-x/-y/-opacity
	   inherit, which is what lets .iot-card/.iot-flow below pick up the
	   values JS sets on their shared ancestor .iot-item. */
	[data-shine],
	[data-shine] .iot-card,
	[data-shine] .iot-flow {
		background-image: radial-gradient(
			circle at var(--shine-x) var(--shine-y),
			rgba(var(--color-teal-rgb), var(--shine-opacity)) 0%,
			transparent 40%
		);
		background-repeat: no-repeat;
		transition: --shine-opacity 300ms ease;
	}

	@media (prefers-reduced-motion: reduce) {
		/* No pointer-tracking JS runs under reduced motion (see script) —
		   instead a fixed, faint, centered glow that never animates. */
		[data-shine],
		[data-shine] .iot-card,
		[data-shine] .iot-flow {
			--shine-opacity: 0.08;
			transition: none;
		}
	}

	/* ---------------------------------------------------------------- */
	/* Tech card: teal-glow + calibration corner-bracket hover treatment,*/
	/* applied alongside each page's own card class.                     */
	/* ---------------------------------------------------------------- */
	.tech-card {
		position: relative;
	}

	.tech-card::before,
	.tech-card::after {
		content: '';
		position: absolute;
		width: 16px;
		height: 16px;
		opacity: 0;
		transition: opacity 0.25s ease, transform 0.25s ease, width 0.3s ease 0.05s;
		pointer-events: none;
		z-index: 2;
	}

	.tech-card::before {
		top: 10px;
		left: 10px;
		border-top: 2px solid var(--color-teal);
		border-left: 2px solid var(--color-teal);
		transform: translate(6px, 6px);
	}

	.tech-card::after {
		bottom: 10px;
		right: 10px;
		border-bottom: 2px solid var(--color-teal);
		border-right: 2px solid var(--color-teal);
		transform: translate(-6px, -6px);
	}

	.tech-card:hover,
	.tech-card:focus-within {
		transform: translateY(-4px);
		box-shadow:
			0 20px 40px rgba(var(--color-indigo-rgb), 0.14),
			0 0 0 1px rgba(var(--color-teal-rgb), 0.3),
			0 0 28px rgba(var(--color-teal-rgb), 0.2);
		border-color: transparent;
	}

	.tech-card:hover::before,
	.tech-card:hover::after,
	.tech-card:focus-within::before,
	.tech-card:focus-within::after {
		opacity: 1;
		transform: translate(0, 0);
	}

	/* Tick-mark trace: the top-left bracket's top arm grows outward into a
	   short trace along the card's top edge on hover, like a measurement
	   mark being drawn out — an extension of the corner-bracket motif
	   rather than a second, competing animation. */
	.tech-card:hover::before,
	.tech-card:focus-within::before {
		width: 36px;
	}

	@media (prefers-reduced-motion: reduce) {
		.tech-card {
			transition: none;
		}

		/* Keep a simple opacity fade for the corner brackets/trace instead of
		   the sliding + growing motion — the brackets still land in their
		   final position and length, just without an animated transform. */
		.tech-card::before,
		.tech-card::after {
			transition: opacity 0.2s ease;
		}
	}
