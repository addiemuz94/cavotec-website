---
import { Image } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import CavotecLogo from '../assets/cavotec-logo.png';
import NavFlyout, { type MenuItem } from '../components/NavFlyout.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Cavotec Malaysia',
	description = 'Cavotec Malaysia Sdn Bhd — connection and electrification solutions.',
} = Astro.props;

// Footer "Quick Links": top-level pages stay flat, but Services/Products
// mirror the full "Our Business" structure below (same ourBusinessMenu data)
// so the footer and the nav mega-menu never drift out of sync.
const footerCompanyLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/our-company', label: 'Our Company' },
	{ href: '/case-studies', label: 'Case Studies' },
	{ href: '/contact', label: 'Contact' },
];

// Header nav: Services and Products are merged into a single "Our Business"
// cascading flyout menu instead of two standalone top-level links. This is
// one recursive tree — "Services"/"Products" are just the level-1 nodes —
// rendered by <NavFlyout> for the header, and re-used flat (grouped by
// these same top-level nodes) for the footer's Quick Links.
const ourBusinessMenu: MenuItem[] = [
	{
		href: '/services',
		label: 'Services',
		children: [
			{ href: '/product/calibration/', label: 'Calibration and Test Measurement' },
			{ href: '/product/repair-work-service/', label: 'Repair Work' },
			{ href: '/product/equipment-rental/', label: 'Equipment Rental' },
			{ href: '/product/training/', label: 'Training' },
			{
				href: '/product/customize-solution-provider/',
				label: 'Customize Solution Provider',
				children: [
					{ href: '/product/customize-solution-provider/electronic-design-service', label: 'Electronic Design Service' },
					{ href: '/product/customize-solution-provider/3d-design-service', label: '3D Design Service' },
					{ href: '/product/rd-service/', label: 'New Product R&D and Innovation' },
				],
			},
		],
	},
	{
		href: '/products',
		label: 'Products',
		children: [
			{
				href: '/product/calibration-test-measurement/',
				label: 'ATE System',
			},
			{
				href: '/product/iot/',
				label: 'Internet of Things (IoT)',
				children: [
					{ href: '/product/iot/smart-key-management-system', label: 'Smart Key Management System (eKMS)' },
					{ href: '/product/iot/integrated-alarm-system', label: 'Integrated Alarm System' },
					{
						href: '/product/iot/bms',
						label: 'Smart Building Management and Monitoring System (BMS)',
					},
				],
			},
		],
	},
];

const headerNavLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/our-company', label: 'Our Company' },
	{ label: 'Our Business', megaMenu: ourBusinessMenu },
	{ href: '/case-studies', label: 'Case Studies' },
	{ href: '/contact', label: 'Contact' },
];

// Only Facebook and YouTube are confirmed accounts for now. YouTube's href
// is a placeholder ("#") until the real channel URL is provided — do not
// point it at a guessed URL.
const socialLinks = [
	{ label: 'Facebook', href: 'https://www.facebook.com/cavotecmalaysia', icon: 'facebook' },
	{ label: 'YouTube', href: '#', icon: 'youtube' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			// Sets [data-theme] on <html> before anything paints, so there is
			// never a flash of the wrong theme on load/refresh. Precedence:
			// explicit past choice (localStorage) > OS preference (matchMedia)
			// > dark fallback if matchMedia itself is unsupported. Must run
			// here, before the stylesheet below, since the [data-theme="light"]
			// CSS block keys off this attribute being present at first paint.
			function applyStoredTheme() {
				var root = document.documentElement;
				var theme = 'dark';
				try {
					var stored = localStorage.getItem('theme-preference');
					if (stored === 'light' || stored === 'dark') {
						theme = stored;
					} else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
						theme = 'light';
					}
				} catch (e) {
					// localStorage/matchMedia unavailable (privacy mode, old
					// browser, etc.) — the 'dark' fallback above already covers it.
				}
				root.setAttribute('data-theme', theme);
			}

			applyStoredTheme();

			// [data-theme] is set by JS only — it's never part of the
			// server-rendered <html> tag, so it isn't something
			// transition:persist can carry over on its own. ClientRouter
			// syncs the persisted <html> element's attributes to match each
			// newly-fetched document's <html> tag on every swap, which wipes
			// this attribute right back off (confirmed via Playwright: it
			// read as null immediately after a soft navigation) since the
			// fetched document never has it either. astro:after-swap fires
			// synchronously right when that swap happens, before the new
			// page paints, so reapplying here closes that gap with no
			// visible flash — same guarantee as the first-paint call above,
			// just repeated on every subsequent transition.
			document.addEventListener('astro:after-swap', applyStoredTheme);
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#1A1D24" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<!-- Client-side page transitions: intercepts same-origin link clicks and
		     swaps the document in place instead of a full unload/reload, which
		     is what was causing the flash/jitter between page navigations (a
		     hard reload shows a blank browser-default frame between the old
		     and new document, and re-runs every script from scratch). Persisted
		     elements below (header/footer/reminder bar) opt out of the
		     swap/crossfade entirely — see their `transition:persist` — so only
		     the actual page content (<main>) animates between navigations. -->
		<ClientRouter />
	</head>
	<body>
		<!-- Persistent "site upgrade" reminder bar. Hidden by default (SSR
		     can't know sessionStorage) — the script below reveals it on every
		     page load once index.astro's upgrade-notice modal has been
		     dismissed this session. Sits above the sticky header, in normal
		     flow, so it scrolls away with the page rather than stacking with
		     the header's own sticky position. -->
		<div class="upgrade-reminder-bar" id="upgrade-reminder-bar" transition:persist transition:name="upgrade-reminder-bar">
			<div class="upgrade-reminder-bar-inner">
				<span class="upgrade-reminder-bar-text">Site upgrade in progress — some content may be incomplete.</span>
				<button type="button" class="upgrade-reminder-bar-close" id="upgrade-reminder-bar-close" aria-label="Dismiss this reminder">
					<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M18 6L6 18M6 6l12 12" />
					</svg>
				</button>
			</div>
		</div>

		<header class="site-header" transition:persist transition:name="site-header">
			<div class="header-inner">
				<div class="header-left">
					<a href="/" class="logo" aria-label="Cavotec home">
						<span class="logo-chip">
							<Image src={CavotecLogo} alt="Cavotec Malaysia Sdn Bhd" width={839} height={147} class="logo-img" />
						</span>
					</a>

					<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme">
						<svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="4" />
							<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
						</svg>
						<svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
						</svg>
					</button>
				</div>

				<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
				<label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation menu">
					<span></span>
					<span></span>
					<span></span>
				</label>

				<nav class="site-nav" aria-label="Main navigation">
					<ul>
						{headerNavLinks.map((link) =>
							link.megaMenu ? (
							<li class="has-dropdown">
								<button
									type="button"
									class="dropdown-toggle"
									aria-expanded="false"
									aria-haspopup="true"
									aria-controls="our-business-menu"
								>
									{link.label}
									<svg class="chevron-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M6 9l6 6 6-6" />
									</svg>
								</button>
								<NavFlyout items={link.megaMenu} id="our-business-menu" />
							</li>
							) : (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							)
						)}
					</ul>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer" transition:persist transition:name="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<span class="logo-chip footer-logo-chip">
						<Image src={CavotecLogo} alt="Cavotec Malaysia Sdn Bhd" width={839} height={147} class="footer-logo" />
					</span>
					<p>Connection and electrification solutions for ports, airports and industry.</p>
				</div>

				<div class="footer-link-groups">
					<nav class="footer-nav" aria-label="Footer navigation">
						<ul>
							{footerCompanyLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))}
						</ul>
					</nav>

					{ourBusinessMenu.map((column) => (
						<nav class="footer-nav footer-business-group" aria-label={`${column.label} links`}>
							<a href={column.href} class="footer-group-title">{column.label}</a>
							<ul>
								{(column.children ?? []).map((item) => (
									<li class={item.children ? 'has-subitems' : undefined}>
										<a href={item.href}>{item.label}</a>
										{item.children && (
											<ul class="footer-subitems">
												{item.children.map((child) => (
													<li>
														<a
															href={child.href}
															target={child.external ? '_blank' : undefined}
															rel={child.external ? 'noopener noreferrer' : undefined}
															aria-label={child.external ? `${child.label} (opens in a new tab)` : undefined}
														>
															{child.label}
															{child.external && (
																<svg class="external-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
																	<path d="M7 17L17 7" />
																	<path d="M8 7h9v9" />
																</svg>
															)}
														</a>
													</li>
												))}
											</ul>
										)}
									</li>
								))}
							</ul>
						</nav>
					))}
				</div>

				<div class="footer-social">
					<span class="footer-social-title">Follow us</span>
					<ul>
						{socialLinks.map((social) => (
							<li>
								<a href={social.href} aria-label={social.label} target="_blank" rel="noopener noreferrer">
									{social.icon === 'facebook' && (
										<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
											<path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z"/>
										</svg>
									)}
									{social.icon === 'youtube' && (
										<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
											<path d="M23.5 6.5s-.23-1.64-.94-2.36c-.9-.94-1.9-.95-2.36-1C16.9 3 12 3 12 3h-.01s-4.89 0-8.19.14c-.46.05-1.46.06-2.36 1C.73 4.86.5 6.5.5 6.5S.27 8.42.27 10.34v1.8c0 1.92.23 3.84.23 3.84s.23 1.64.94 2.36c.9.94 2.09.91 2.62 1.01C6 19.5 12 19.55 12 19.55s4.9-.01 8.2-.15c.46-.06 1.46-.07 2.36-1.01.71-.72.94-2.36.94-2.36s.23-1.92.23-3.84v-1.8c0-1.92-.23-3.84-.23-3.84zM9.75 14.85V8.66l6 3.1-6 3.09z"/>
										</svg>
									)}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>

			<div class="footer-bottom">
				<p>Copyright &copy; Cavotec Malaysia Sdn Bhd 2026. All Rights Reserved.</p>
			</div>
		</footer>
	</body>
</html>

<script>
	// Persistent "site upgrade" reminder bar. Runs on every page (not just
	// home) — index.astro's upgrade-notice modal sets this same
	// sessionStorage flag on dismiss, and this check is what makes the bar
	// reappear automatically on every subsequent page/reload within the
	// session without re-showing the modal itself.
	const UPGRADE_STORAGE_KEY = 'upgrade-notice-dismissed';
	const upgradeReminderBar = document.getElementById('upgrade-reminder-bar');
	const upgradeReminderBarClose = document.getElementById('upgrade-reminder-bar-close');

	function isUpgradeNoticeDismissed(): boolean {
		try {
			return sessionStorage.getItem(UPGRADE_STORAGE_KEY) === '1';
		} catch (e) {
			return false;
		}
	}

	if (upgradeReminderBar && isUpgradeNoticeDismissed()) {
		upgradeReminderBar.classList.add('is-visible');
	}

	// Closing the bar itself is per-page-view only (no new storage write) —
	// the modal's dismissal is what's permanent for the session; this "x"
	// just declutters the current page without demoting that.
	upgradeReminderBarClose?.addEventListener('click', () => {
		upgradeReminderBar?.classList.remove('is-visible');
	});

	// Light/dark theme toggle. The inline <head> script already set
	// [data-theme] before first paint (localStorage > OS preference > dark
	// fallback) — this just wires up the button and keeps localStorage/the
	// meta theme-color in sync from here on.
	const THEME_STORAGE_KEY = 'theme-preference';
	const root = document.documentElement;
	const themeToggle = document.getElementById('theme-toggle');
	const themeColorMeta = document.querySelector('meta[name="theme-color"]');
	const themeColorByMode: Record<'dark' | 'light', string> = { dark: '#1A1D24', light: '#FAFAF9' };

	function currentTheme(): 'dark' | 'light' {
		return root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
	}

	function applyTheme(theme: 'dark' | 'light', { persist }: { persist: boolean }) {
		root.setAttribute('data-theme', theme);
		if (themeColorMeta) themeColorMeta.setAttribute('content', themeColorByMode[theme]);
		if (themeToggle) {
			themeToggle.setAttribute('aria-label', theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
		}
		if (persist) {
			try {
				localStorage.setItem(THEME_STORAGE_KEY, theme);
			} catch (e) {
				// Storage unavailable (privacy mode, etc.) — the toggle still
				// works for this page view, it just won't persist.
			}
		}
	}

	// Reflect the theme the head script already picked into the button's
	// label immediately (it only set the attribute, not the label/meta).
	applyTheme(currentTheme(), { persist: false });

	themeToggle?.addEventListener('click', () => {
		applyTheme(currentTheme() === 'light' ? 'dark' : 'light', { persist: true });
	});

	// Live-follow the OS setting ONLY until the user makes an explicit
	// choice of their own — once localStorage has a value, that choice
	// always wins over the system preference from then on.
	if (window.matchMedia) {
		window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
			let hasExplicitChoice = false;
			try {
				hasExplicitChoice = localStorage.getItem(THEME_STORAGE_KEY) !== null;
			} catch (e) {
				hasExplicitChoice = false;
			}
			if (hasExplicitChoice) return;
			applyTheme(event.matches ? 'light' : 'dark', { persist: false });
		});
	}

	// ------------------------------------------------------------------
	// Page-content effects (scroll-reveal, header/page-header/closing-CTA
	// parallax backgrounds, card shine) — everything in this function
	// targets elements that live inside <main>, which DOES get replaced on
	// every ClientRouter navigation (unlike the persisted header/footer/
	// reminder bar above, whose own listeners are bound once, further
	// down, and never need to be re-bound since those elements are never
	// destroyed). Wrapped in its own function and re-run via the
	// astro:page-load event — which fires once on the true initial load
	// and again after every subsequent transition — instead of running
	// once at the top of this script, which would only ever apply to
	// whichever page happened to load first and silently do nothing on
	// every page after that. Each run gets its own AbortController so the
	// previous run's window-level listeners (scroll, resize) are torn down
	// on astro:before-swap rather than silently accumulating one more
	// live copy — each still doing work against that run's now-detached
	// elements — on every navigation.
	// ------------------------------------------------------------------
	let contentEffectsController: AbortController | null = null;

	function initPageContentEffects() {
		contentEffectsController?.abort();
		contentEffectsController = new AbortController();
		const { signal } = contentEffectsController;

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// Lightweight scroll-reveal: progressive enhancement only.
		// If JS never runs, or the user prefers reduced motion, [data-reveal]
		// elements stay at full opacity (see the CSS default in the global
		// stylesheet) — nothing ever gets stuck hidden.
		if (!prefersReducedMotion && 'IntersectionObserver' in window) {
			document.documentElement.classList.add('reveal-enabled');

			const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

			// Elements already on-screen at this exact moment get marked
			// visible in the SAME synchronous pass as the .reveal-enabled
			// class above, not asynchronously via the observer's first
			// callback — otherwise there's a frame where they sit hidden
			// (opacity: 0, just freshly hidden by that class landing) before
			// the observer fires and re-reveals them: a visible flash/pop of
			// already-settled content on every single page load, and the
			// single biggest contributor to the reported nav jitter, since
			// it fired on every page load even before ClientRouter existed.
			// Only elements NOT yet on-screen get observed for a genuine
			// scroll-triggered reveal.
			const viewportBottom = window.innerHeight + 40; // matches the observer's rootMargin below
			const toObserve: HTMLElement[] = [];
			revealEls.forEach((el) => {
				const rect = el.getBoundingClientRect();
				if (rect.top < viewportBottom && rect.bottom > 0) {
					el.classList.add('is-visible');
				} else {
					toObserve.push(el);
				}
			});

			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
			);

			toObserve.forEach((el) => observer.observe(el));
			signal.addEventListener('abort', () => observer.disconnect());
		}

		// Subtle scroll-based depth for hero/page-header/closing-CTA background
		// grid textures (marked with [data-parallax-bg]) — the background drifts
		// at a fraction of scroll speed, so it lags slightly behind the
		// foreground content instead of scrolling in lockstep. Disabled for
		// reduced motion and on touch/narrow-viewport devices, where scroll-
		// linked transforms tend to read as janky rather than smooth.
		const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax-bg]');
		const isCoarsePointer = window.matchMedia('(pointer: coarse)').matches;
		const isNarrowViewport = window.innerWidth <= 768;

		if (!prefersReducedMotion && !isCoarsePointer && !isNarrowViewport && parallaxEls.length) {
			let parallaxTicking = false;

			const updateParallax = () => {
				parallaxEls.forEach((el) => {
					const parent = el.parentElement;
					if (!parent) return;
					const offset = parent.getBoundingClientRect().top * 0.12;
					el.style.transform = `translate3d(0, ${offset}px, 0)`;
				});
				parallaxTicking = false;
			};

			const onParallaxScroll = () => {
				if (!parallaxTicking) {
					requestAnimationFrame(updateParallax);
					parallaxTicking = true;
				}
			};

			window.addEventListener('scroll', onParallaxScroll, { passive: true, signal });
			window.addEventListener('resize', onParallaxScroll, { passive: true, signal });
			updateParallax();
		}

		// Card shine — single shared utility for every [data-shine] card
		// site-wide (service/product/pillar/IoT/customize/case-study cards all
		// carry it alongside .tech-card). Tracks the cursor position within the
		// card as a 0–100% coordinate and writes it to --shine-x/--shine-y; the
		// CSS above (registered via @property) handles rendering the gradient
		// and smoothly transitioning --shine-opacity on its own — this only
		// ever sets target values, never animates anything itself.
		const ACTIVE_SHINE_OPACITY = '0.15';

		function updateShinePosition(card: HTMLElement, event: PointerEvent) {
			const rect = card.getBoundingClientRect();
			const x = Math.min(100, Math.max(0, ((event.clientX - rect.left) / rect.width) * 100));
			const y = Math.min(100, Math.max(0, ((event.clientY - rect.top) / rect.height) * 100));
			card.style.setProperty('--shine-x', `${x}%`);
			card.style.setProperty('--shine-y', `${y}%`);
		}

		if (!prefersReducedMotion) {
			document.querySelectorAll<HTMLElement>('[data-shine]').forEach((card) => {
				card.addEventListener('pointermove', (event) => updateShinePosition(card, event), { passive: true, signal });

				card.addEventListener(
					'pointerenter',
					(event) => {
						updateShinePosition(card, event);
						card.style.setProperty('--shine-opacity', ACTIVE_SHINE_OPACITY);
					},
					{ passive: true, signal }
				);

				card.addEventListener(
					'pointerleave',
					() => {
						card.style.setProperty('--shine-opacity', '0');
					},
					{ passive: true, signal }
				);
			});
		}
		// If motion is reduced, [data-shine] elements never get these listeners
		// — the CSS reduced-motion rule instead shows a fixed, faint, centered
		// glow (see [data-shine] in the global styles), never one that tracks
		// the pointer.
	}

	// astro:page-load fires once on the true initial load and again after
	// every subsequent ClientRouter transition — the "re-run this setup on
	// every page" hook DOMContentLoaded can't provide beyond the first
	// load. astro:before-swap fires just before the outgoing page's <main>
	// is torn down, which is when this run's window-level listeners need
	// to go with it.
	document.addEventListener('astro:page-load', initPageContentEffects);
	document.addEventListener('astro:before-swap', () => contentEffectsController?.abort());

	// "Our Business" nav: a cascading flyout menu on desktop (hover-intent
	// with a short open/close delay, plus arrow-key navigation), falling
	// back to a click/tap accordion on touch, where the whole tree is just
	// shown/hidden by the top-level toggle (see the mobile CSS in
	// NavFlyout.astro — nested panels render inline there, not as flyouts).
	//
	// "Owner" = any element that has its own flyout panel as a direct DOM
	// child: the top-level `.has-dropdown` <li> (panel = the root
	// <NavFlyout>) and every `.flyout-row.has-children` <li> (panel = its
	// nested <NavFlyout>). Both cases are handled identically below.
	const HOVER_DELAY = 150;
	const desktopFlyoutQuery = window.matchMedia('(min-width: 981px) and (hover: hover) and (pointer: fine)');
	const isDesktopFlyout = () => desktopFlyoutQuery.matches;

	function ownerTrigger(owner: Element): HTMLElement | null {
		return owner.querySelector(':scope > .dropdown-toggle, :scope > .flyout-link');
	}

	function ownerPanel(owner: Element): HTMLElement | null {
		return owner.querySelector(':scope > .flyout-panel');
	}

	function closeBranch(owner: Element) {
		owner.classList.remove('is-open');
		ownerPanel(owner)?.classList.remove('is-open');
		owner.querySelectorAll('.flyout-row.is-open, .flyout-panel.is-open').forEach((el) => el.classList.remove('is-open'));
		ownerTrigger(owner)?.setAttribute('aria-expanded', 'false');
	}

	// A panel that would run off the right edge of the viewport (e.g. a
	// 3rd-level flyout on a narrower desktop window) flips to open toward
	// the left instead, so it's never clipped or forced into horizontal
	// page scroll. Measured fresh on every open, since which rows are open
	// above it can change how far right this panel already sits.
	function positionPanel(panel: HTMLElement) {
		panel.classList.remove('flyout-panel--flip');
		if (panel.getBoundingClientRect().right > window.innerWidth - 8) {
			panel.classList.add('flyout-panel--flip');
		}
	}

	function focusFirstLink(owner: HTMLElement) {
		owner.querySelector<HTMLElement>(':scope > .flyout-panel .flyout-link')?.focus();
	}

	function openOwner(owner: HTMLElement) {
		// Only one branch open per level: close sibling owners before opening this one.
		const parent = owner.parentElement;
		if (parent) {
			Array.from(parent.children).forEach((sibling) => {
				if (sibling !== owner && (sibling.classList.contains('flyout-row') || sibling.classList.contains('has-dropdown'))) {
					closeBranch(sibling);
				}
			});
		}
		owner.classList.add('is-open');
		const panel = ownerPanel(owner);
		panel?.classList.add('is-open');
		if (panel && isDesktopFlyout()) positionPanel(panel);
		ownerTrigger(owner)?.setAttribute('aria-expanded', 'true');
	}

	const hoverTimers = new WeakMap<Element, { open?: number; close?: number }>();

	function clearHoverTimers(owner: Element) {
		const t = hoverTimers.get(owner);
		if (!t) return;
		if (t.open) window.clearTimeout(t.open);
		if (t.close) window.clearTimeout(t.close);
		hoverTimers.delete(owner);
	}

	function scheduleOpen(owner: HTMLElement) {
		const t = hoverTimers.get(owner) ?? {};
		if (t.close) {
			window.clearTimeout(t.close);
			t.close = undefined;
		}
		if (owner.classList.contains('is-open') || t.open) {
			hoverTimers.set(owner, t);
			return;
		}
		t.open = window.setTimeout(() => {
			openOwner(owner);
			const current = hoverTimers.get(owner);
			if (current) current.open = undefined;
		}, HOVER_DELAY);
		hoverTimers.set(owner, t);
	}

	function scheduleClose(owner: HTMLElement) {
		const t = hoverTimers.get(owner) ?? {};
		if (t.open) {
			window.clearTimeout(t.open);
			t.open = undefined;
		}
		if (t.close) {
			hoverTimers.set(owner, t);
			return;
		}
		t.close = window.setTimeout(() => {
			closeBranch(owner);
			const current = hoverTimers.get(owner);
			if (current) current.close = undefined;
		}, HOVER_DELAY);
		hoverTimers.set(owner, t);
	}

	const flyoutOwners = document.querySelectorAll<HTMLElement>('.has-dropdown, .flyout-row.has-children');

	flyoutOwners.forEach((owner) => {
		owner.addEventListener('pointerenter', (event) => {
			if (!(event instanceof PointerEvent) || event.pointerType !== 'mouse' || !isDesktopFlyout()) return;
			scheduleOpen(owner);
		});
		owner.addEventListener('pointerleave', (event) => {
			if (!(event instanceof PointerEvent) || event.pointerType !== 'mouse' || !isDesktopFlyout()) return;
			scheduleClose(owner);
		});
		owner.addEventListener('focusout', (event) => {
			const next = event.relatedTarget;
			if (next instanceof Node && owner.contains(next)) return;
			clearHoverTimers(owner);
			closeBranch(owner);
		});
	});

	// Top-level toggle: click/tap opens & closes the whole menu — this is
	// what drives the mobile accordion (no hover there), and on desktop it
	// also works as an immediate (no-delay) alternative to hovering.
	document.querySelectorAll<HTMLElement>('.dropdown-toggle').forEach((toggle) => {
		const owner = toggle.closest<HTMLElement>('.has-dropdown');
		if (!owner) return;

		toggle.addEventListener('click', () => {
			clearHoverTimers(owner);
			if (owner.classList.contains('is-open')) {
				closeBranch(owner);
			} else {
				openOwner(owner);
			}
		});
	});

	document.addEventListener('click', (event) => {
		document.querySelectorAll<HTMLElement>('.has-dropdown.is-open').forEach((owner) => {
			if (event.target instanceof Node && owner.contains(event.target)) return;
			clearHoverTimers(owner);
			closeBranch(owner);
		});
	});

	document.addEventListener('keydown', (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;

		// Escape: close everything and return focus to the top-level trigger.
		if (event.key === 'Escape') {
			document.querySelectorAll<HTMLElement>('.has-dropdown.is-open').forEach((owner) => {
				clearHoverTimers(owner);
				closeBranch(owner);
				ownerTrigger(owner)?.focus();
			});
			return;
		}

		// Opening the top-level trigger with the keyboard.
		if (target.classList.contains('dropdown-toggle')) {
			if (event.key === 'Enter' || event.key === ' ' || event.key === 'ArrowDown') {
				const owner = target.closest<HTMLElement>('.has-dropdown');
				if (!owner) return;
				event.preventDefault();
				openOwner(owner);
				focusFirstLink(owner);
			}
			return;
		}

		// Arrow-key navigation within an open flyout panel, matching the
		// WAI-ARIA menu pattern basics: Up/Down move between sibling rows,
		// Right opens a child flyout (if any), Left closes the current one.
		if (!target.classList.contains('flyout-link')) return;

		const row = target.closest<HTMLElement>('.flyout-row');
		const panel = target.closest<HTMLElement>('.flyout-panel');
		if (!row || !panel) return;

		const siblingLinks = Array.from(panel.querySelectorAll<HTMLElement>(':scope > ul > .flyout-row > .flyout-link'));
		const index = siblingLinks.indexOf(target);

		if (event.key === 'ArrowDown') {
			event.preventDefault();
			siblingLinks[(index + 1) % siblingLinks.length]?.focus();
		} else if (event.key === 'ArrowUp') {
			event.preventDefault();
			siblingLinks[(index - 1 + siblingLinks.length) % siblingLinks.length]?.focus();
		} else if (event.key === 'ArrowRight' || event.key === 'Enter' || event.key === ' ') {
			if (!row.classList.contains('has-children')) return;
			event.preventDefault();
			openOwner(row);
			focusFirstLink(row);
		} else if (event.key === 'ArrowLeft') {
			const parentOwner = panel.parentElement;
			if (!parentOwner || !(parentOwner.classList.contains('flyout-row') || parentOwner.classList.contains('has-dropdown'))) return;
			event.preventDefault();
			clearHoverTimers(parentOwner);
			closeBranch(parentOwner);
			ownerTrigger(parentOwner)?.focus();
		}
	});

	// Card shine setup now lives inside initPageContentEffects() above (it
	// targets [data-shine] cards inside <main>, which get replaced on every
	// navigation, so it has to re-run with the rest of that function rather
	// than once here at the top level).
</script>

<style is:global>
	/*
	 * Shared design-system primitives used across every page:
	 * tokens, type scale, the tick/ruled-grid motif, scroll reveal,
	 * and the "tech-card" hover treatment (teal glow + calibration
	 * corner brackets). Page-specific layout lives in each page's
	 * own scoped <style> block.
	 */
	/* Theme system: :root holds the dark palette (this site's default —
	   matches [data-theme="dark"] and, for old/no-JS clients, the
	   prefers-color-scheme fallback below). [data-theme="light"] further
	   down overrides the same custom properties with light equivalents.
	   Every page consumes only the generic --color-bg/-text/-border-style
	   names (or their underlying --color-indigo and --color-ink sources),
	   never a raw hex, so flipping these here re-themes the whole site.
	   The one deliberate exception is --color-shadow-rgb: shadows stay
	   dark-tinted in both themes (a light UI still uses dark, low-opacity
	   shadows for elevation — only backgrounds/text/borders invert). */
	:root {
		/* Base — soft dark theme. "Indigo" names are kept so every existing
		   var(--color-indigo*) reference (page-header gradients, button
		   text, badge tints, …) repaints automatically; only the values
		   changed. Originally a near-black theme (#0a0a0c/#16161a) — lifted
		   to a lighter charcoal/slate so the site reads as dark mode rather
		   than near-black, with muted text bumped up to match. */
		--color-indigo: #1a1d24;
		--color-indigo-rgb: 26, 29, 36;
		--color-indigo-dark: #121419;
		--color-surface: #24272f;
		/* Gradient's lighter stop reuses the elevated-surface tone, so
		   page-header/hero banners fade toward the same tone their cards
		   and panels sit on. */
		--color-indigo-light: var(--color-surface);
		/* Hairline border for dark surfaces — tick-marks, dividers, card
		   borders — used instead of translucent-white/black tricks so
		   separation reads crisp against the charcoal base. */
		--color-border-dark: #363a45;

		/* Accents — identical in both themes (brand teal/amber don't
		   invert), EXCEPT the "-dark" text/icon variants below, which are
		   specifically calibrated per theme (see the light block). */
		--color-teal: #00c2d1;
		--color-teal-rgb: 0, 194, 209;
		--color-amber: #f2a950;
		--color-amber-rgb: 242, 169, 80;

		/* Text on dark surfaces */
		--color-ink: #f2f3f5;
		--color-ink-rgb: 242, 243, 245;
		--color-ink-muted: #a0a5af;

		/* Dedicated shadow tint — deliberately NOT overridden in the light
		   block. rgba(var(--color-indigo-rgb), …) used to double as "the
		   shadow color" only because dark mode's page background happened
		   to be near-black; once --color-indigo-rgb flips to a light value
		   in light mode, reusing it for box-shadow would produce a nearly
		   invisible white shadow instead of depth. This stays a constant
		   near-black in both themes, the way shadows normally work. */
		--color-shadow-rgb: 10, 10, 12;

		/* Guaranteed-dark text/icon color for use ON TOP OF the bright teal/
		   amber accent fills (buttons, hover states, ::selection) — these
		   fills don't change between themes, so the text sitting on them
		   shouldn't either. Also deliberately NOT overridden in the light
		   block, same reasoning as --color-shadow-rgb above: these call
		   sites used to read var(--color-indigo) for this purely because
		   dark mode's page background happened to already be dark; now that
		   --color-indigo flips to near-white in light mode, that reuse would
		   put near-white text on a teal button. */
		--color-on-accent: #1a1d24;

		/* var(--color-teal-dark, #018b96) / var(--color-amber-dark) are used
		   as `color:` (text/icon) values ~12x across the pages, never as a
		   fill — kept distinct from the base --color-teal/--color-amber
		   because the base accents don't clear text-contrast minimums (see
		   the light block, where they're the ones that actually change). In
		   dark mode the base accents already contrast fine as text, so
		   these just alias straight to them. */
		--color-teal-dark: var(--color-teal);
		--color-amber-dark: #d98f36;

		/* Surfaces & text — every page's card/section CSS reads only these
		   generic names (never --color-indigo/--color-surface/--color-ink
		   directly), so re-pointing them here is what actually re-themes
		   the site: --color-bg-alt is the page tone, --color-bg is the
		   elevated/card tone, text/border follow the same split. */
		--color-bg: var(--color-surface);
		--color-bg-alt: var(--color-indigo);
		--color-text: var(--color-ink);
		--color-text-muted: var(--color-ink-muted);
		--color-border: var(--color-border-dark);

		/* Newer, spec-named aliases for the same tokens above — additive
		   only, existing var(--color-bg/-text/…) call sites are untouched. */
		--color-bg-elevated: var(--color-surface);
		--color-accent-teal: var(--color-teal);
		--color-accent-amber: var(--color-amber);

		/* Back-compat aliases so every existing var(--color-navy/--color-accent, …)
		   reference across the site picks up the new palette automatically. */
		--color-navy: var(--color-indigo);
		--color-navy-dark: var(--color-indigo-dark);
		--color-accent: var(--color-teal);

		/* Type */
		--font-display: 'Space Grotesk', 'Segoe UI', system-ui, sans-serif;
		--font-body: 'Inter', 'Segoe UI', system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
		--font-mono: 'IBM Plex Mono', 'Consolas', 'SFMono-Regular', monospace;

		--max-width: 1200px;
		--header-height: 76px;
	}

	/* No-JS / pre-hydration fallback only — the inline head script normally
	   sets [data-theme] before first paint, so this rarely applies in
	   practice. Mirrors the same three-state logic: OS-preferred light
	   wins unless a "dark" choice was already made explicit. */
	@media (prefers-color-scheme: light) {
		:root:not([data-theme='dark']) {
			--color-indigo: #fafaf9;
			--color-indigo-rgb: 250, 250, 249;
			--color-indigo-dark: #eeeff2;
			--color-surface: #ffffff;
			--color-border-dark: #e2e4e8;
			--color-ink: #1a1d24;
			--color-ink-rgb: 26, 29, 36;
			--color-ink-muted: #5b606b;
			--color-teal-dark: #017885;
			--color-amber-dark: #8f5a1c;
		}
	}

	/* Explicit light theme — set by the toggle (see the script at the
	   bottom of this file) or by the head script reading a stored
	   "theme-preference". Wins regardless of OS preference. */
	:root[data-theme='light'] {
		--color-indigo: #fafaf9;
		--color-indigo-rgb: 250, 250, 249;
		/* Gradient's dark stop: a hair cooler/deeper than the base page
		   tone, so page-header banners still show a subtle diagonal fade
		   rather than flattening to a single flat color. */
		--color-indigo-dark: #eeeff2;
		--color-surface: #ffffff;
		--color-border-dark: #e2e4e8;
		--color-ink: #1a1d24;
		--color-ink-rgb: 26, 29, 36;
		--color-ink-muted: #5b606b;
		/* Base --color-teal/--color-amber are NOT overridden here — kept
		   pixel-identical across both themes per spec, since as fills/
		   borders/glows (not text) they don't need it. As TEXT/icon color
		   they measure 2.18:1 and 1.99:1 against white — badly under the
		   3:1 floor — so the "-dark" text-safe variants get real, darker
		   values here instead of aliasing straight to the base accent:
		   #017885 (teal) → 5.22:1 / #8F5A1C (amber) → 5.76:1 against
		   white, both comfortably clearing 4.5:1. */
		--color-teal-dark: #017885;
		--color-amber-dark: #8f5a1c;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		/* Defensive: matches body's own background below. The stylesheet is
		   render-blocking so this rarely matters (nothing paints before it's
		   parsed anyway), but it removes any chance of a browser-default
		   white frame showing through on the sliver of navigations that
		   still fall back to a hard reload (JS disabled, prefetch failed,
		   a hard refresh, …) instead of a ClientRouter-handled transition. */
		background: var(--color-bg-alt);
	}

	html {
		/* Closed/off-screen nested flyout panels (NavFlyout.astro) sit at
		   `left: 100%` relative to their trigger row so they can slide in
		   from the right — deliberately NOT display:none or width:0 while
		   closed (see that file's comment on why the hidden state has to
		   stay a plain opacity/visibility flip, not a layout-removing one,
		   for the keyboard-focus timing this menu depends on). That leaves
		   them occupying real layout position off past the right edge even
		   while invisible, which used to push document.documentElement's
		   scrollWidth past the viewport on every page. Harmless in
		   practice (nothing made it reachable — no visible scrollbar, no
		   pannable content), but cutting it off here is simpler than
		   changing how the menu itself is hidden. Scoped to `html`, not
		   inherited by nested scroll containers with their own overflow-x
		   (e.g. ComparisonTable.astro's horizontal-scroll wrapper on
		   mobile), which stay unaffected. */
		overflow-x: hidden;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		font-family: var(--font-body);
		color: var(--color-text);
		background: var(--color-bg-alt);
	}

	main {
		flex: 1;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-family: var(--font-display);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	::selection {
		background: rgba(var(--color-teal-rgb), 0.25);
		color: var(--color-on-accent);
	}

	/* ---------------------------------------------------------------- */
	/* Monospace "instrument readout" treatment for numbers, badges,     */
	/* category tags and specs.                                         */
	/* ---------------------------------------------------------------- */
	.spec-mono {
		font-family: var(--font-mono);
		letter-spacing: 0.02em;
		font-variant-numeric: tabular-nums;
	}

	/* ---------------------------------------------------------------- */
	/* Tick-mark / ruled-scale divider — a section boundary that reads   */
	/* like a measurement scale instead of a plain border line.          */
	/* ---------------------------------------------------------------- */
	.tick-divider {
		width: 100%;
		height: 22px;
		background-image:
			repeating-linear-gradient(
				90deg,
				var(--color-border) 0,
				var(--color-border) 1px,
				transparent 1px,
				transparent 14px
			),
			repeating-linear-gradient(
				90deg,
				rgba(var(--color-teal-rgb), 0.55) 0,
				rgba(var(--color-teal-rgb), 0.55) 1.5px,
				transparent 1.5px,
				transparent 70px
			);
		background-repeat: repeat-x, repeat-x;
		background-position: center, center;
		background-size: auto 9px, auto 16px;
	}

	/* ---------------------------------------------------------------- */
	/* Scroll reveal. Default state = fully visible, so content never    */
	/* disappears without JS. Only once .reveal-enabled is set on <html> */
	/* (JS ran + motion is allowed) do elements start hidden and animate */
	/* in as they cross the viewport.                                    */
	/*                                                                    */
	/* .reveal-enabled and .is-visible are wrapped in :where(...), which  */
	/* matches identically but always contributes zero to specificity.    */
	/* Without it, the settled-state rule below was                      */
	/* html.reveal-enabled [data-reveal].is-visible — specificity (0,3,1) */
	/* — which permanently beat any hover/focus rule with fewer than 3    */
	/* classes (e.g. .tech-card:hover's translateY(-4px) lift, or         */
	/* .btn-accent:hover's translateY(-2px), both (0,2,0)) on any element */
	/* that also happens to carry [data-reveal], silently killing those   */
	/* hover states once the card/button had scrolled into view and       */
	/* settled. Keeping `html` and `[data-reveal]` outside :where() still */
	/* gives this rule (0,1,1) — just enough to keep beating the plain    */
	/* (0,1,0) base/pre-reveal rules below and above it, so the reveal    */
	/* animation itself is untouched, while any interactive :hover/       */
	/* :focus rule (2+ classes) now correctly wins afterward. */
	[data-reveal] {
		opacity: 1;
		transform: none;
	}

	html:where(.reveal-enabled) [data-reveal] {
		opacity: 0;
		transform: translateY(22px);
		transition: opacity 0.7s ease, transform 0.7s ease;
		transition-delay: calc(var(--reveal-i, 0) * 70ms);
	}

	html:where(.reveal-enabled) [data-reveal]:where(.is-visible) {
		opacity: 1;
		transform: none;
	}

	/* ---------------------------------------------------------------- */
	/* Card shine: a soft radial highlight that tracks the cursor within */
	/* any [data-shine] card (every .tech-card site-wide — service,      */
	/* product, IoT, case-study and "customize" cards all carry both).   */
	/* Registering these as typed custom properties lets the browser     */
	/* smoothly interpolate --shine-opacity on its own via a plain CSS   */
	/* transition — no rAF loop needed, only the JS below setting the    */
	/* target values on pointer events (see the script's CardShine bit). */
	/* ---------------------------------------------------------------- */
	@property --shine-x {
		syntax: '<percentage>';
		inherits: true;
		initial-value: 50%;
	}

	@property --shine-y {
		syntax: '<percentage>';
		inherits: true;
		initial-value: 50%;
	}

	@property --shine-opacity {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	/* Implemented as an extra background-image layer, not a ::before/
	   ::after pseudo-element: .tech-card already spends both pseudo-
	   element slots on its corner-bracket marks (below), and a
	   background layer sidesteps z-index/stacking entirely — backgrounds
	   always paint behind an element's own content by definition, so
	   this can never cover the card's text/icons no matter what, and it
	   composes with the corner brackets (z-index: 2) and hover glow
	   without any extra stacking-context work. --shine-x/-y/-opacity
	   inherit, which is what lets .iot-card/.iot-flow below pick up the
	   values JS sets on their shared ancestor .iot-item. */
	[data-shine],
	[data-shine] .iot-card,
	[data-shine] .iot-flow {
		background-image: radial-gradient(
			circle at var(--shine-x) var(--shine-y),
			rgba(var(--color-teal-rgb), var(--shine-opacity)) 0%,
			transparent 40%
		);
		background-repeat: no-repeat;
		transition: --shine-opacity 300ms ease;
	}

	@media (prefers-reduced-motion: reduce) {
		/* No pointer-tracking JS runs under reduced motion (see script) —
		   instead a fixed, faint, centered glow that never animates. */
		[data-shine],
		[data-shine] .iot-card,
		[data-shine] .iot-flow {
			--shine-opacity: 0.08;
			transition: none;
		}
	}

	/* ---------------------------------------------------------------- */
	/* Tech card: teal-glow + calibration corner-bracket hover treatment,*/
	/* applied alongside each page's own card class.                     */
	/* ---------------------------------------------------------------- */
	.tech-card {
		position: relative;
	}

	.tech-card::before,
	.tech-card::after {
		content: '';
		position: absolute;
		width: 16px;
