---
import CavotecLogo from '../assets/cavotec-logo.svg';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Cavotec Malaysia',
	description = 'Cavotec Malaysia Sdn Bhd — connection and electrification solutions.',
} = Astro.props;

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/our-company', label: 'Our Company' },
	{ href: '/services', label: 'Services' },
	{ href: '/products', label: 'Products' },
	{ href: 'https://kms-cvt.com', label: 'Smart Key Management System', external: true },
	{ href: '/contact', label: 'Contact' },
];

const socialLinks = [
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/company/cavotec', icon: 'linkedin' },
	{ label: 'Facebook', href: 'https://www.facebook.com/cavotec', icon: 'facebook' },
	{ label: 'X (Twitter)', href: 'https://twitter.com/cavotec', icon: 'x' },
	{ label: 'YouTube', href: 'https://www.youtube.com/cavotec', icon: 'youtube' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0B1E3A" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="header-inner">
				<a href="/" class="logo" aria-label="Cavotec home">
					<img src={CavotecLogo.src} alt="Cavotec" width="150" height="34" />
				</a>

				<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
				<label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation menu">
					<span></span>
					<span></span>
					<span></span>
				</label>

				<nav class="site-nav" aria-label="Main navigation">
					<ul>
						{navLinks.map((link) => (
							<li>
								<a
									href={link.href}
									target={link.external ? '_blank' : undefined}
									rel={link.external ? 'noopener noreferrer' : undefined}
									aria-label={link.external ? `${link.label} (opens in a new tab)` : undefined}
								>
									{link.label}
									{link.external && (
										<svg class="external-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M7 17L17 7" />
											<path d="M8 7h9v9" />
										</svg>
									)}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<img src={CavotecLogo.src} alt="Cavotec" width="140" height="32" class="footer-logo" />
					<p>Connection and electrification solutions for ports, airports and industry.</p>
				</div>

				<nav class="footer-nav" aria-label="Footer navigation">
					<ul>
						{navLinks.map((link) => (
							<li>
								<a
									href={link.href}
									target={link.external ? '_blank' : undefined}
									rel={link.external ? 'noopener noreferrer' : undefined}
									aria-label={link.external ? `${link.label} (opens in a new tab)` : undefined}
								>
									{link.label}
									{link.external && (
										<svg class="external-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M7 17L17 7" />
											<path d="M8 7h9v9" />
										</svg>
									)}
								</a>
							</li>
						))}
					</ul>
				</nav>

				<div class="footer-social">
					<span class="footer-social-title">Follow us</span>
					<ul>
						{socialLinks.map((social) => (
							<li>
								<a href={social.href} aria-label={social.label} target="_blank" rel="noopener noreferrer">
									{social.icon === 'linkedin' && (
										<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
											<path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.25h4.5V23h-4.5V8.25zM8.5 8.25h4.31v2.01h.06c.6-1.14 2.07-2.35 4.26-2.35 4.56 0 5.4 3 5.4 6.9V23h-4.5v-6.77c0-1.62-.03-3.7-2.25-3.7-2.26 0-2.6 1.76-2.6 3.58V23h-4.5V8.25z"/>
										</svg>
									)}
									{social.icon === 'facebook' && (
										<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
											<path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z"/>
										</svg>
									)}
									{social.icon === 'x' && (
										<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
											<path d="M18.9 2H22l-7.6 8.68L23 22h-6.9l-5.4-6.86L4.6 22H1.5l8.13-9.29L1 2h7.1l4.88 6.27L18.9 2zm-1.2 18h1.7L6.4 4h-1.8l13.1 16z"/>
										</svg>
									)}
									{social.icon === 'youtube' && (
										<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
											<path d="M23.5 6.5s-.23-1.64-.94-2.36c-.9-.94-1.9-.95-2.36-1C16.9 3 12 3 12 3h-.01s-4.89 0-8.19.14c-.46.05-1.46.06-2.36 1C.73 4.86.5 6.5.5 6.5S.27 8.42.27 10.34v1.8c0 1.92.23 3.84.23 3.84s.23 1.64.94 2.36c.9.94 2.09.91 2.62 1.01C6 19.5 12 19.55 12 19.55s4.9-.01 8.2-.15c.46-.06 1.46-.07 2.36-1.01.71-.72.94-2.36.94-2.36s.23-1.92.23-3.84v-1.8c0-1.92-.23-3.84-.23-3.84zM9.75 14.85V8.66l6 3.1-6 3.09z"/>
										</svg>
									)}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>

			<div class="footer-bottom">
				<p>Copyright &copy; Cavotec Malaysia Sdn Bhd 2026. All Rights Reserved.</p>
			</div>
		</footer>
	</body>
</html>

<script>
	// Lightweight scroll-reveal: progressive enhancement only.
	// If JS never runs, or the user prefers reduced motion, [data-reveal]
	// elements stay at full opacity (see the CSS default in the global
	// stylesheet) — nothing ever gets stuck hidden.
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!prefersReducedMotion && 'IntersectionObserver' in window) {
		document.documentElement.classList.add('reveal-enabled');

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
		);

		document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
	}
</script>

<style is:global>
	/*
	 * Shared design-system primitives used across every page:
	 * tokens, type scale, the tick/ruled-grid motif, scroll reveal,
	 * and the "tech-card" hover treatment (teal glow + calibration
	 * corner brackets). Page-specific layout lives in each page's
	 * own scoped <style> block.
	 */
	:root {
		/* Base */
		--color-indigo: #0b1e3a;
		--color-indigo-dark: #061224;
		--color-indigo-light: #14315c;

		/* Accents */
		--color-teal: #00c2d1;
		--color-teal-rgb: 0, 194, 209;
		--color-amber: #f2a950;
		--color-amber-dark: #d98f36;
		--color-amber-rgb: 242, 169, 80;

		/* Surfaces & text */
		--color-bg: #ffffff;
		--color-bg-alt: #f7f8fa;
		--color-text: #3c4858;
		--color-text-muted: #6b7686;
		--color-border: #e1e6ee;

		/* Back-compat aliases so every existing var(--color-navy/--color-accent, …)
		   reference across the site picks up the new palette automatically. */
		--color-navy: var(--color-indigo);
		--color-navy-dark: var(--color-indigo-dark);
		--color-accent: var(--color-teal);

		/* Type */
		--font-display: 'Space Grotesk', 'Segoe UI', system-ui, sans-serif;
		--font-body: 'Inter', 'Segoe UI', system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
		--font-mono: 'IBM Plex Mono', 'Consolas', 'SFMono-Regular', monospace;

		--max-width: 1200px;
		--header-height: 76px;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		font-family: var(--font-body);
		color: var(--color-text);
		background: var(--color-bg-alt);
	}

	main {
		flex: 1;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-family: var(--font-display);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	::selection {
		background: rgba(var(--color-teal-rgb), 0.25);
		color: var(--color-indigo);
	}

	/* ---------------------------------------------------------------- */
	/* Monospace "instrument readout" treatment for numbers, badges,     */
	/* category tags and specs.                                         */
	/* ---------------------------------------------------------------- */
	.spec-mono {
		font-family: var(--font-mono);
		letter-spacing: 0.02em;
		font-variant-numeric: tabular-nums;
	}

	/* ---------------------------------------------------------------- */
	/* Tick-mark / ruled-scale divider — a section boundary that reads   */
	/* like a measurement scale instead of a plain border line.          */
	/* ---------------------------------------------------------------- */
	.tick-divider {
		width: 100%;
		height: 22px;
		background-image:
			repeating-linear-gradient(
				90deg,
				var(--color-border) 0,
				var(--color-border) 1px,
				transparent 1px,
				transparent 14px
			),
			repeating-linear-gradient(
				90deg,
				rgba(var(--color-teal-rgb), 0.55) 0,
				rgba(var(--color-teal-rgb), 0.55) 1.5px,
				transparent 1.5px,
				transparent 70px
			);
		background-repeat: repeat-x, repeat-x;
		background-position: center, center;
		background-size: auto 9px, auto 16px;
	}

	/* ---------------------------------------------------------------- */
	/* Scroll reveal. Default state = fully visible, so content never    */
	/* disappears without JS. Only once .reveal-enabled is set on <html> */
	/* (JS ran + motion is allowed) do elements start hidden and animate */
	/* in as they cross the viewport.                                    */
	/* ---------------------------------------------------------------- */
	[data-reveal] {
		opacity: 1;
		transform: none;
	}

	html.reveal-enabled [data-reveal] {
		opacity: 0;
		transform: translateY(22px);
		transition: opacity 0.7s ease, transform 0.7s ease;
		transition-delay: calc(var(--reveal-i, 0) * 70ms);
	}

	html.reveal-enabled [data-reveal].is-visible {
		opacity: 1;
		transform: none;
	}

	/* ---------------------------------------------------------------- */
	/* Tech card: teal-glow + calibration corner-bracket hover treatment,*/
	/* applied alongside each page's own card class.                     */
	/* ---------------------------------------------------------------- */
	.tech-card {
		position: relative;
	}

	.tech-card::before,
	.tech-card::after {
		content: '';
		position: absolute;
		width: 16px;
		height: 16px;
		opacity: 0;
		transition: opacity 0.25s ease, transform 0.25s ease;
		pointer-events: none;
		z-index: 2;
	}

	.tech-card::before {
		top: 10px;
		left: 10px;
		border-top: 2px solid var(--color-teal);
		border-left: 2px solid var(--color-teal);
		transform: translate(6px, 6px);
	}

	.tech-card::after {
		bottom: 10px;
		right: 10px;
		border-bottom: 2px solid var(--color-teal);
		border-right: 2px solid var(--color-teal);
		transform: translate(-6px, -6px);
	}

	.tech-card:hover,
	.tech-card:focus-within {
		transform: translateY(-4px);
		box-shadow:
			0 20px 40px rgba(11, 30, 58, 0.14),
			0 0 0 1px rgba(var(--color-teal-rgb), 0.3),
			0 0 28px rgba(var(--color-teal-rgb), 0.2);
		border-color: transparent;
	}

	.tech-card:hover::before,
	.tech-card:hover::after,
	.tech-card:focus-within::before,
	.tech-card:focus-within::after {
		opacity: 1;
		transform: translate(0, 0);
	}

	@media (prefers-reduced-motion: reduce) {
		.tech-card,
		.tech-card::before,
		.tech-card::after {
			transition: none;
		}
	}
</style>

<style>
	/* Header */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
		box-shadow: 0 1px 3px rgba(11, 30, 58, 0.06);
	}

	.header-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--header-height);
		padding: 0 1.5rem;
	}

	.logo {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.logo img {
		display: block;
		height: 34px;
		width: auto;
	}

	.site-nav ul {
		display: flex;
		align-items: center;
		gap: 1.75rem;
	}

	.site-nav a {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-indigo);
		letter-spacing: 0.01em;
		padding: 0.5rem 0.1rem;
		position: relative;
		white-space: nowrap;
	}

	.external-icon {
		flex-shrink: 0;
		margin-left: 0.35rem;
		opacity: 0.7;
	}

	.site-nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 100%;
		bottom: -2px;
		height: 2px;
		background: var(--color-teal);
		transition: right 0.2s ease;
	}

	.site-nav a:hover::after,
	.site-nav a:focus-visible::after {
		right: 0;
	}

	.site-nav a:hover,
	.site-nav a:focus-visible {
		color: var(--color-teal);
	}

	.nav-toggle {
		display: none;
	}

	.nav-toggle-label {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 32px;
		height: 32px;
		cursor: pointer;
	}

	.nav-toggle-label span {
		display: block;
		height: 2px;
		width: 100%;
		background: var(--color-indigo);
		border-radius: 2px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	/* Footer */
	.site-footer {
		background: var(--color-indigo);
		color: #c3cede;
	}

	.footer-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr;
		gap: 2.5rem;
		padding: 3.5rem 1.5rem 2.5rem;
	}

	.footer-brand img {
		height: 28px;
		width: auto;
		filter: brightness(0) invert(1);
		margin-bottom: 1rem;
	}

	.footer-brand p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: #93a2b8;
		max-width: 32ch;
	}

	.footer-nav ul {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-nav a {
		display: inline-flex;
		align-items: center;
		font-size: 0.9rem;
		color: #c3cede;
		transition: color 0.15s ease;
	}

	.footer-nav .external-icon {
		margin-left: 0.3rem;
	}

	.footer-nav a:hover,
	.footer-nav a:focus-visible {
		color: var(--color-teal);
	}

	.footer-social {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.9rem;
	}

	.footer-social-title {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: #93a2b8;
	}

	.footer-social ul {
		display: flex;
		gap: 0.75rem;
	}

	.footer-social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.08);
		color: #c3cede;
		transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
	}

	.footer-social a:hover,
	.footer-social a:focus-visible {
		background: var(--color-teal);
		color: var(--color-indigo);
		transform: translateY(-2px);
		box-shadow: 0 0 18px rgba(var(--color-teal-rgb), 0.5);
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding: 1.25rem 1.5rem;
	}

	.footer-bottom p {
		max-width: var(--max-width);
		margin: 0 auto;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
		color: #93a2b8;
		text-align: center;
	}

	/* Responsive */
	@media (max-width: 980px) {
		.header-inner {
			padding: 0 1.25rem;
		}

		.nav-toggle-label {
			display: flex;
		}

		.site-nav {
			position: absolute;
			top: var(--header-height);
			left: 0;
			right: 0;
			background: var(--color-bg);
			border-bottom: 1px solid var(--color-border);
			box-shadow: 0 8px 16px rgba(11, 30, 58, 0.08);
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.25s ease;
		}

		.site-nav ul {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.5rem 1.25rem 1rem;
		}

		.site-nav li {
			border-bottom: 1px solid var(--color-border);
		}

		.site-nav a {
			display: flex;
			white-space: normal;
			padding: 0.85rem 0.1rem;
		}

		.nav-toggle:checked ~ .site-nav {
			max-height: 400px;
		}

		.nav-toggle:checked ~ .nav-toggle-label span:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}

		.nav-toggle:checked ~ .nav-toggle-label span:nth-child(2) {
			opacity: 0;
		}

		.nav-toggle:checked ~ .nav-toggle-label span:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}

		.footer-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding: 2.75rem 1.5rem 2rem;
		}
	}
</style>
