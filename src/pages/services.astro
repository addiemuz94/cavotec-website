---
import Layout from '../layouts/Layout.astro';

const mainServices = [
	{
		title: 'Repairs',
		description:
			"Cavotec Malaysia has been providing repair and service solutions since 2006, covering defense, manufacturing, and other high-tech sectors, with deep experience in Tektronix and Fluke equipment.",
		icon: 'wrench',
	},
	{
		title: 'Calibration',
		description:
			'Cavotec Malaysia has calibrated equipment from over 2,400 manufacturers. All laboratories, including the Mobile Calibration Laboratory, are NATA accredited and ISO certified, with calibration provided to manufacturers’ specifications and NATA reporting available.',
		icon: 'badge',
	},
	{
		title: 'Products and Services',
		description:
			'Cavotec Malaysia provides test and measurement products, services, training, customized solutions, and equipment rental, plus RF and microwave accessories such as antennas, cables, adapters, connectors, and multi-couplers.',
		icon: 'package',
	},
];

const productCategories = [
	{
		title: 'Radio Test Set',
		description: 'Analog and digital radio testing for mobile, repeater, and base station',
		icon: 'antenna',
	},
	{
		title: 'Signal Sources',
		description: 'Analog and digital RF signal generators',
		icon: 'wave',
	},
	{
		title: 'Signal Analyzers',
		description: 'Vector signal analysis',
		icon: 'analyzer',
	},
	{
		title: 'Avionics',
		description: 'Civil, commercial, and military aviation/aerospace testing',
		icon: 'plane',
	},
	{
		title: 'Telecommunication',
		description: 'Digital analyzers',
		icon: 'phone',
	},
	{
		title: 'Microwave',
		description: 'Scalar network analyzers, system analyzers, counters, power meters',
		icon: 'dish',
	},
	{
		title: 'Spectrum Analyzer',
		description: 'Portable and bench-type',
		icon: 'spectrum',
	},
	{
		title: 'PXI System',
		description: 'RF modular instruments for lab, R&D, and manufacturing',
		icon: 'chip',
	},
	{
		title: 'Wireless',
		description: 'LTE test sets and conformance testing',
		icon: 'wifi',
	},
	{
		title: 'Broadband Systems',
		description: 'Broadband RF signal analysis, recording, and generation',
		icon: 'tower',
	},
];
---

<Layout
	title="Services — Cavotec Malaysia Sdn Bhd"
	description="Repair, calibration, and test and measurement products and services from Cavotec Malaysia, covering a full range of radio, RF, microwave, and telecommunication product categories."
>
	<section class="page-header">
		<div class="page-header-grid" aria-hidden="true"></div>
		<div class="page-header-inner" data-reveal>
			<span class="eyebrow">What We Offer</span>
			<h1>Services</h1>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="services-detail">
		<div class="services-detail-inner">
			<div class="service-detail-grid">
				{mainServices.map((service, index) => (
					<div class="service-detail-card tech-card" data-reveal style={`--reveal-i: ${index};`}>
						<span class="service-detail-icon" aria-hidden="true">
							{service.icon === 'wrench' && (
								<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M14.7 6.3a4 4 0 0 0-5.4 4.6L4 16.2V20h3.8l5.3-5.3a4 4 0 0 0 4.6-5.4l-2.6 2.6-2-2 2.6-2.6z" />
								</svg>
							)}
							{service.icon === 'badge' && (
								<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="9" r="6" />
									<path d="M9 14.5L7 22l5-3 5 3-2-7.5" />
									<path d="M9.5 9l1.8 1.8L14.5 7.5" />
								</svg>
							)}
							{service.icon === 'package' && (
								<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5v-9z" />
									<path d="M3.5 7.5L12 12l8.5-4.5" />
									<path d="M12 12v9" />
								</svg>
							)}
						</span>
						<h2>{service.title}</h2>
						<p>{service.description}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="product-categories">
		<div class="product-categories-inner">
			<h2 class="section-heading" data-reveal>Product Categories</h2>
			<div class="category-grid">
				{productCategories.map((category, index) => (
					<div class="category-card tech-card" data-reveal style={`--reveal-i: ${index % 5};`}>
						<span class="category-icon" aria-hidden="true">
							{category.icon === 'antenna' && (
								<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M4 10a8 8 0 0 1 16 0" />
									<path d="M7.5 10a4.5 4.5 0 0 1 9 0" />
									<circle cx="12" cy="10" r="1.3" fill="currentColor" stroke="none" />
									<path d="M12 11.3V21" />
									<path d="M9 21h6" />
								</svg>
							)}
							{category.icon === 'wave' && (
								<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M2 12c1.5 0 1.5-6 3-6s1.5 12 3 12 1.5-12 3-12 1.5 12 3 12 1.5-6 3-6 1.5-6 3-6" />
								</svg>
							)}
							{category.icon === 'analyzer' && (
								<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 20h18" />
									<path d="M6 20v-6M11 20V8M16 20v-10M21 20v-4" />
								</svg>
							)}
							{category.icon === 'plane' && (
								<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M2 16l20-6-3 7 3 7-8-3-4 4-1-6-6-3z" />
								</svg>
							)}
							{category.icon === 'phone' && (
								<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M5 4h4l1.5 5-2.5 1.5a12 12 0 0 0 5.5 5.5L15 13.5l5 1.5v4a2 2 0 0 1-2 2C10.5 21 3 13.5 3 6a2 2 0 0 1 2-2z" />
								</svg>
							)}
							{category.icon === 'dish' && (
								<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 12a15 15 0 0 1 18 0" />
									<path d="M12 12v9" />
									<circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" />
									<path d="M9 21h6" />
									<path d="M17 6l3-3" />
								</svg>
							)}
							{category.icon === 'spectrum' && (
								<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M4 20V10M9 20V4M14 20v-8M19 20v-5" />
								</svg>
							)}
							{category.icon === 'chip' && (
								<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<rect x="7" y="7" width="10" height="10" rx="1.5" />
									<path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" />
								</svg>
							)}
							{category.icon === 'wifi' && (
								<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M2 8.5a16 16 0 0 1 20 0" />
									<path d="M5.5 12.5a11 11 0 0 1 13 0" />
									<path d="M9 16.5a6 6 0 0 1 6 0" />
									<circle cx="12" cy="20" r="1.2" fill="currentColor" stroke="none" />
								</svg>
							)}
							{category.icon === 'tower' && (
								<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 2l7 20M12 2L5 22" />
									<path d="M8.5 12h7M6.5 17h11" />
									<path d="M12 2v4" />
								</svg>
							)}
						</span>
						<div>
							<h3>{category.title}</h3>
							<p>{category.description}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	section {
		width: 100%;
	}

	/* Page header */
	.page-header {
		position: relative;
		background: linear-gradient(135deg, var(--color-indigo-dark) 0%, var(--color-indigo) 55%, var(--color-indigo-light) 100%);
		color: #ffffff;
		padding: 4.5rem 1.5rem 3.5rem;
		text-align: center;
		overflow: hidden;
		isolation: isolate;
	}

	.page-header-grid {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			repeating-linear-gradient(90deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px),
			repeating-linear-gradient(0deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px);
		mask-image: radial-gradient(ellipse at center, black 15%, transparent 75%);
	}

	.page-header-inner {
		max-width: 760px;
		margin: 0 auto;
		position: relative;
	}

	.eyebrow {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-amber);
		margin-bottom: 0.75rem;
	}

	.page-header h1 {
		font-size: clamp(2rem, 4.5vw, 2.75rem);
		font-weight: 700;
		margin: 0;
	}

	.section-heading {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		color: var(--color-indigo);
		margin: 0 0 3rem;
		text-align: center;
		position: relative;
	}

	.section-heading::after {
		content: '';
		display: block;
		width: 64px;
		height: 3px;
		background: var(--color-teal);
		margin: 0.9rem auto 0;
		border-radius: 2px;
	}

	/* Main services */
	.services-detail {
		background: var(--color-bg);
		padding: 5rem 1.5rem;
	}

	.services-detail-inner {
		max-width: 1200px;
		margin: 0 auto;
	}

	.service-detail-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.service-detail-card {
		background: var(--color-bg-alt);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: 2.5rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.service-detail-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: rgba(var(--color-teal-rgb), 0.12);
		color: var(--color-teal-dark, #018b96);
	}

	.service-detail-card h2 {
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--color-indigo);
		margin: 0;
	}

	.service-detail-card p {
		font-size: 0.96rem;
		line-height: 1.7;
		color: var(--color-text-muted);
		margin: 0;
	}

	/* Product categories */
	.product-categories {
		background: var(--color-bg-alt);
		padding: 5rem 1.5rem;
	}

	.product-categories-inner {
		max-width: 1200px;
		margin: 0 auto;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
	}

	.category-card {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 10px;
		padding: 1.5rem;
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
	}

	.category-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 46px;
		height: 46px;
		border-radius: 50%;
		background: rgba(11, 30, 58, 0.06);
		color: var(--color-indigo);
		transition: background 0.25s ease, color 0.25s ease;
	}

	.category-card:hover .category-icon {
		background: var(--color-teal);
		color: var(--color-indigo);
	}

	.category-card h3 {
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
		margin: 0 0 0.35rem;
	}

	.category-card p {
		font-size: 0.86rem;
		line-height: 1.5;
		color: var(--color-text-muted);
		margin: 0;
	}

	@media (max-width: 600px) {
		.page-header {
			padding: 3.5rem 1.25rem 2.75rem;
		}

		.services-detail,
		.product-categories {
			padding: 3.5rem 1.25rem;
		}

		.service-detail-card {
			padding: 2rem 1.5rem;
		}

		.category-card {
			padding: 1.25rem;
		}
	}
</style>
