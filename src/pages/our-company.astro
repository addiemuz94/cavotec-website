---
import Layout from '../layouts/Layout.astro';

const brands = ['Aeroflex', 'Giga-tronics', 'Promax', 'Cadex', 'and more'];

const pillars = [
	{
		title: 'Test & Measurement Solutions',
		description: 'An extensive range of equipment from leading global brands.',
		icon: 'gauge',
	},
	{
		title: 'Training Programmes',
		description: 'Customised courses on analog and digital radio testing.',
		icon: 'cap',
	},
	{
		title: 'Repair, Calibration & Rental',
		description: 'Full lifecycle support for your test equipment.',
		icon: 'wrench',
	},
	{
		title: 'Radio & RF Accessories',
		description: 'Antennas, cables, connectors, multi-couplers and more.',
		icon: 'antenna',
	},
];
---

<Layout
	title="Our Company — Cavotec Malaysia Sdn Bhd"
	description="Learn about Cavotec Malaysia's mission and key business areas in test and measurement solutions, calibration, training, and RF accessories."
>
	<section class="page-header">
		<div class="page-header-grid" aria-hidden="true" data-parallax-bg></div>
		<div class="page-header-inner" data-reveal>
			<span class="eyebrow">About Us</span>
			<h1>Our Company</h1>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="mission">
		<div class="mission-inner" data-reveal>
			<h2>Our Mission</h2>
			<p>
				At Cavotec Malaysia, we don't just talk about precision — we deliver it. With over a
				decade of hands-on experience in calibration, instrumentation, and equipment repair,
				we've built our reputation solving real technical problems for the industries that
				depend on accuracy. That expertise now extends into IoT development, electronic and
				electrical R&amp;D, and test measurement automation — helping our customers modernize
				their operations without compromising the reliability they've always trusted us for.
			</p>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="key-business">
		<div class="key-business-inner">
			<h2 data-reveal>Our Key Business</h2>

			<div class="key-business-text" data-reveal style="--reveal-i: 1;">
				<p>
					Cavotec Malaysia is a specialized provider of test and measurement solutions,
					calibration, and equipment repair services across Malaysia. We represent and support
					instrumentation from leading global brands — including Aeroflex, Giga-tronics, Promax,
					and Cadex — giving our customers access to trusted, industry-standard equipment backed
					by local expertise.
				</p>
				<p>
					Beyond core test and measurement services, we offer customized training programs
					covering analog and digital radio testing, from portable units to repeater and base
					station systems, alongside equipment repair, calibration, and rental services tailored
					to each customer's needs.
				</p>
				<p>
					Our capabilities have grown to meet where the industry is heading — IoT development,
					electronic and electrical R&amp;D, and test measurement automation — alongside our
					established radio communications products and RF/microwave accessories, including
					antennas, cables, connectors, multi-couplers, and more.
				</p>
			</div>

			<div class="pillars-grid">
				{pillars.map((pillar, index) => (
					<div class="pillar-card tech-card" data-shine data-reveal style={`--reveal-i: ${index};`}>
						<span class="pillar-icon" aria-hidden="true">
							{pillar.icon === 'gauge' && (
								<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 21a9 9 0 1 0-9-9" />
									<path d="M12 21a9 9 0 0 0 9-9" />
									<path d="M12 12L16 8" />
									<circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none" />
								</svg>
							)}
							{pillar.icon === 'cap' && (
								<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 3l10 5-10 5L2 8l10-5z" />
									<path d="M6 10.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-5.5" />
									<path d="M22 8v6" />
								</svg>
							)}
							{pillar.icon === 'wrench' && (
								<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M14.7 6.3a4 4 0 0 0-5.4 4.6L4 16.2V20h3.8l5.3-5.3a4 4 0 0 0 4.6-5.4l-2.6 2.6-2-2 2.6-2.6z" />
								</svg>
							)}
							{pillar.icon === 'antenna' && (
								<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M4 10a8 8 0 0 1 16 0" />
									<path d="M7.5 10a4.5 4.5 0 0 1 9 0" />
									<circle cx="12" cy="10" r="1.3" fill="currentColor" stroke="none" />
									<path d="M12 11.3V21" />
									<path d="M9 21h6" />
								</svg>
							)}
						</span>
						<div>
							<h3>{pillar.title}</h3>
							<p>{pillar.description}</p>
						</div>
					</div>
				))}
			</div>

			<div class="brands" data-reveal>
				<span class="brands-title">Brands We Work With</span>
				<ul>
					{brands.map((brand) => (
						<li class="spec-mono">{brand}</li>
					))}
				</ul>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Page header */
	.page-header {
		position: relative;
		background: linear-gradient(135deg, var(--color-indigo-dark) 0%, var(--color-indigo) 55%, var(--color-indigo-light) 100%);
		color: var(--color-ink);
		padding: 4.5rem 1.5rem 3.5rem;
		text-align: center;
		overflow: hidden;
		isolation: isolate;
	}

	.page-header-grid {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			repeating-linear-gradient(90deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px),
			repeating-linear-gradient(0deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px);
		mask-image: radial-gradient(ellipse at center, black 15%, transparent 75%);
	}

	.page-header-inner {
		max-width: 760px;
		margin: 0 auto;
		position: relative;
	}

	.eyebrow {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-amber);
		margin-bottom: 0.75rem;
	}

	.page-header h1 {
		font-size: clamp(2rem, 4.5vw, 2.75rem);
		font-weight: 700;
		margin: 0;
	}

	/* Shared heading style */
	.mission h2,
	.key-business h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		color: var(--color-ink);
		margin: 0 0 1.75rem;
		text-align: center;
		position: relative;
	}

	.mission h2::after,
	.key-business h2::after {
		content: '';
		display: block;
		width: 64px;
		height: 3px;
		background: var(--color-teal);
		margin: 0.9rem auto 0;
		border-radius: 2px;
	}

	/* Mission */
	.mission {
		background: var(--color-bg);
		padding: 5rem 1.5rem;
	}

	.mission-inner {
		max-width: 720px;
		margin: 0 auto;
		text-align: center;
	}

	.mission-inner p {
		font-size: 1.1rem;
		line-height: 1.75;
		color: var(--color-text-muted);
		margin: 0;
	}

	/* Key business */
	.key-business {
		background: var(--color-bg-alt);
		padding: 5rem 1.5rem;
	}

	.key-business-inner {
		max-width: 1000px;
		margin: 0 auto;
	}

	.key-business-text {
		max-width: 760px;
		margin: 0 auto 3.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.key-business-text p {
		font-size: 1.05rem;
		line-height: 1.75;
		color: var(--color-text);
		margin: 0;
	}

	.pillars-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
		margin-bottom: 3rem;
	}

	.pillar-card {
		/* background-color, not the background shorthand — see the matching
		   comment on .service-card in index.astro for why. */
		background-color: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 10px;
		padding: 1.75rem 1.5rem;
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.pillar-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: rgba(var(--color-teal-rgb), 0.12);
		color: var(--color-teal);
	}

	.pillar-card h3 {
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
		margin: 0 0 0.4rem;
	}

	.pillar-card p {
		font-size: 0.88rem;
		line-height: 1.55;
		color: var(--color-text-muted);
		margin: 0;
	}

	/* Brands */
	.brands {
		text-align: center;
	}

	.brands-title {
		display: block;
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: 1.1rem;
	}

	.brands ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}

	.brands li {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		padding: 0.5rem 1.25rem;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--color-ink);
	}

	@media (max-width: 600px) {
		.page-header {
			padding: 3.5rem 1.25rem 2.75rem;
		}

		.mission,
		.key-business {
			padding: 3.5rem 1.25rem;
		}

		.pillar-card {
			padding: 1.5rem 1.25rem;
		}
	}
</style>
