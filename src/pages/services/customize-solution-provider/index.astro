---
import Layout from '../../../layouts/Layout.astro';
import HowItWorksFlow from '../../../components/product/HowItWorksFlow.astro';
import FaqAccordion from '../../../components/product/FaqAccordion.astro';
import ComparisonTable from '../../../components/product/ComparisonTable.astro';

// PLACEHOLDER CONTENT — this page follows the reference structure built for
// src/pages/product/iot/smart-key-management-system.astro. Copy below is
// generic, plausible placeholder text for Cavotec's Customize Solution
// Provider capability generally, pending real details.

const features = [
	'Electronic design and custom PCB development',
	'3D design, modelling, and prototyping support',
	'End-to-end R&D and product innovation services',
	'Services engaged individually or combined',
	'Collaborative approach tailored to your project',
];

const howItWorksSteps = [
	{
		label: 'Consultation',
		description: 'Discuss your project requirements and goals',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>',
	},
	{
		label: 'Solution Scoping',
		description: 'The right combination of services is scoped for your project',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /><path d="M9 13h6M9 17h6" /></svg>',
	},
	{
		label: 'Design & Development',
		description: 'Our team designs and develops your custom solution',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="6" height="6" rx="1" /><path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" /></svg>',
	},
	{
		label: 'Delivery',
		description: 'The completed solution is finalized and delivered',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12" /></svg>',
	},
];

// PLACEHOLDER CONTENT — generic, plausible Q&As for Cavotec's Customize
// Solution Provider capability generally, pending real details.
const faqs = [
	{
		question: 'Which of your services is right for my project?',
		answer:
			'It depends on your project\'s needs — our team can help determine whether Electronic Design, 3D Design, R&D, or a combination is the right fit.',
	},
	{
		question: 'Can these services be combined on a single project?',
		answer: 'Yes — many projects draw on more than one of our Customize Solution Provider services together.',
	},
	{
		question: 'Do you work with customers outside test and measurement?',
		answer:
			'Our core expertise is in test and measurement, but our design and R&D capabilities can support a range of custom hardware projects.',
	},
	{
		question: 'How do I get started?',
		answer: "Contact us to discuss your project, and we'll help scope the right service or combination of services.",
	},
	{
		question: "Can you take on a project that's already underway?",
		answer: 'In many cases, yes — our team can review existing work and advise on the best path forward.',
	},
];

// PLACEHOLDER CONTENT — illustrative comparison rows pending confirmed
// service data.
const comparisonRows = [
	{ capability: 'Time to Start', baseline: 'Months of hiring', cavotec: 'Engage and begin quickly' },
	{ capability: 'Service Breadth', baseline: 'Single skillset', cavotec: 'Electronic, 3D, and R&D combined' },
	{ capability: 'Cost Structure', baseline: 'Fixed overhead', cavotec: 'Scoped to project needs' },
	{ capability: 'Flexibility', baseline: 'Fixed capacity', cavotec: 'Scale services to project demands' },
	{ capability: 'Risk', baseline: 'Team ramp-up risk', cavotec: 'Established process and experience' },
];

// Links to the 3 sub-pages under this category — see the "Featured Product"
// section below, same tech-card pattern used on the IoT landing page.
const featuredServices = [
	{
		href: '/services/customize-solution-provider/electronic-design-service',
		title: 'Electronic Design Service',
		description: 'Custom PCB and embedded electronics design tailored to your application.',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="6" height="6" rx="1" /><path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" /></svg>',
	},
	{
		href: '/services/customize-solution-provider/3d-design-service',
		title: '3D Design Service',
		description: '3D modelling and mechanical design for custom enclosures, fixtures, and hardware.',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" /><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5" /></svg>',
	},
	{
		href: '/services/customize-solution-provider/new-product-rd-and-innovation',
		title: 'New Product R&D and Innovation',
		description: 'End-to-end research and development, from concept through production-ready design.',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4" /><path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1.1 1.3 1.1 2.2h5c0-.9.5-1.7 1.1-2.2A6 6 0 0 0 12 3z" /></svg>',
	},
];
---

<Layout
	title="Customize Solution Provider — Cavotec Malaysia Sdn Bhd"
	description="Custom electronic design, 3D design, and R&D services from Cavotec Malaysia — bringing new products and solutions to life."
>
	<section class="page-header">
		<div class="page-header-grid" aria-hidden="true" data-parallax-bg></div>
		<div class="page-header-inner" data-reveal>
			<span class="eyebrow">Services</span>
			<h1>Customize Solution Provider</h1>
			<p class="product-tagline">
				Custom electronic design, 3D design, and R&amp;D services — bringing new products and
				solutions to life.
			</p>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="product-overview">
		<div class="product-overview-inner">
			<div class="product-image-placeholder" data-reveal>
				<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="4" width="18" height="16" rx="2" />
					<circle cx="8.5" cy="9.5" r="1.5" />
					<path d="M21 16l-5.5-5.5a1.5 1.5 0 0 0-2.1 0L4 19" />
				</svg>
				<strong>Customize Solution Provider</strong>
				<span>Product image — coming soon</span>
			</div>

			<div class="product-description" data-reveal style="--reveal-i: 1;">
				<h2>About the Service</h2>
				<p>
					Cavotec Malaysia's Customize Solution Provider service brings together electronic
					design, 3D design, and R&amp;D capabilities to support customers with custom hardware
					and product development needs. From a single custom component to a full new product,
					our team works alongside customers throughout the process.
				</p>
				<p>
					Each of our specialized services — Electronic Design, 3D Design, and New Product R&amp;D
					and Innovation — can be engaged individually or combined, depending on the scope of your
					project. Explore each service below to learn more.
				</p>
				<p>
					Whether you need a custom PCB, a 3D-modeled enclosure, or full end-to-end product
					development, our Customize Solution Provider capability is built to support ideas from
					concept through to a production-ready result.
				</p>

				<h3>Key Features</h3>
				<ul class="product-features">
					{features.map((feature) => (
						<li>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="12" cy="12" r="9" />
								<path d="M8 12.5l2.5 2.5L16 9" />
							</svg>
							<span>{feature}</span>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<!-- Featured products: links to the 3 fully-built sub-pages rather than
	     duplicating their content, same tech-card pattern used on the IoT
	     landing page's Smart Key Management System card. -->
	<section class="featured-product">
		<div class="featured-product-inner">
			<span class="eyebrow-mono">Our Services</span>
			<div class="featured-product-grid">
				{featuredServices.map((service) => (
					<a href={service.href} class="featured-product-card tech-card" data-shine data-reveal>
						<span class="featured-product-icon" aria-hidden="true" set:html={service.iconSvg} />
						<span class="featured-product-body">
							<span class="featured-product-title">{service.title}</span>
							<span class="featured-product-description">{service.description}</span>
						</span>
						<svg class="featured-product-arrow" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12h14M13 6l6 6-6 6" />
						</svg>
					</a>
				))}
			</div>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<!-- PLACEHOLDER CONTENT: the 4 steps below are illustrative — adjust
	     wording once real engagement workflow details are confirmed. -->
	<section class="product-how-it-works">
		<div class="product-how-it-works-inner">
			<h2 data-reveal>How It Works</h2>
			<HowItWorksFlow steps={howItWorksSteps} />
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<!-- PLACEHOLDER CONTENT: the 5 Q&As below are generic, plausible copy
	     pending real details — replace once confirmed. -->
	<section class="product-faq">
		<div class="product-faq-inner">
			<h2 data-reveal>Frequently Asked Questions</h2>
			<FaqAccordion faqs={faqs} />
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<!-- PLACEHOLDER CONTENT: the comparison rows below are illustrative,
	     pending confirmed service data. -->
	<section class="product-comparison">
		<div class="product-comparison-inner">
			<h2 data-reveal>Cavotec Customize Solution Provider vs. Building an In-House Team</h2>
			<ComparisonTable baselineLabel="Building an In-House Team" cavotecLabel="Cavotec Customize Solution Provider" rows={comparisonRows} />
		</div>
	</section>

	<section class="closing-cta">
		<div class="closing-cta-grid" aria-hidden="true" data-parallax-bg></div>
		<div class="closing-cta-inner" data-reveal>
			<h2>Bring Your Idea to Life</h2>
			<p>Discuss your project with our team and see how we can help.</p>
			<div class="product-cta-group">
				<a href="/contact?subject=Customize%20Solution%20Provider" class="btn btn-accent">Discuss Your Project</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Page header — same recipe used on every other page; each page keeps
	   its own copy since this <style> block is scoped to this file. */
	.page-header {
		position: relative;
		background: linear-gradient(135deg, var(--color-indigo-dark) 0%, var(--color-indigo) 55%, var(--color-indigo-light) 100%);
		color: var(--color-ink);
		padding: 4.5rem 1.5rem 3.5rem;
		text-align: center;
		overflow: hidden;
		isolation: isolate;
	}

	.page-header-grid {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			repeating-linear-gradient(90deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px),
			repeating-linear-gradient(0deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px);
		mask-image: radial-gradient(ellipse at center, black 15%, transparent 75%);
	}

	.page-header-inner {
		max-width: 760px;
		margin: 0 auto;
		position: relative;
	}

	.eyebrow {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-amber);
		margin-bottom: 0.75rem;
	}

	.page-header h1 {
		font-size: clamp(2rem, 4.5vw, 2.75rem);
		font-weight: 700;
		margin: 0 0 0.85rem;
	}

	.product-tagline {
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--color-ink-muted);
		max-width: 56ch;
		margin: 0 auto;
	}

	/* Overview */
	.product-overview {
		background: var(--color-bg);
		padding: 5rem 1.5rem;
	}

	.product-overview-inner {
		max-width: 1100px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
		gap: 3rem;
		align-items: start;
	}

	.product-image-placeholder {
		aspect-ratio: 4 / 3;
		/* No explicit width — a grid item stretches to fill its column by
		   default; see the equivalent comment on the SKMS page for why
		   width: 100% here would overflow under content-box sizing. */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		text-align: center;
		padding: 1.5rem;
		color: var(--color-text-muted);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: repeating-linear-gradient(
			135deg,
			var(--color-indigo),
			var(--color-indigo) 10px,
			var(--color-surface) 10px,
			var(--color-surface) 20px
		);
		position: sticky;
		top: calc(var(--header-height) + 1.5rem);
	}

	.product-image-placeholder strong {
		font-size: 1rem;
		color: var(--color-text);
	}

	.product-image-placeholder span {
		font-size: 0.8rem;
	}

	.product-description h2 {
		font-size: 1.4rem;
		color: var(--color-text);
		margin: 0 0 1.25rem;
	}

	.product-description h3 {
		font-size: 1.05rem;
		color: var(--color-text);
		margin: 2rem 0 1rem;
	}

	.product-description p {
		font-size: 0.98rem;
		line-height: 1.75;
		color: var(--color-text-muted);
		margin: 0 0 1.25rem;
	}

	.product-features {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.product-features li {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.product-features svg {
		flex-shrink: 0;
		margin-top: 0.1rem;
		color: var(--color-teal);
	}

	.product-cta-group {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.85rem 2rem;
		border-radius: 4px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0.01em;
		border: none;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
	}

	.btn-accent {
		background: var(--color-teal);
		color: var(--color-on-accent);
		box-shadow: 0 6px 20px rgba(var(--color-teal-rgb), 0.35);
	}

	.btn-accent:hover,
	.btn-accent:focus-visible {
		background: #00d9eb;
		transform: translateY(-2px);
		box-shadow: 0 10px 26px rgba(var(--color-teal-rgb), 0.45);
	}

	@media (max-width: 860px) {
		.product-overview-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.product-image-placeholder {
			position: static;
			max-width: 380px;
			margin: 0 auto;
		}
	}

	@media (max-width: 600px) {
		.product-overview {
			padding: 3.5rem 1.25rem;
		}

		.product-cta-group {
			flex-direction: column;
			align-items: stretch;
		}

		.btn {
			justify-content: center;
		}
	}

	/* Featured products */
	.featured-product {
		background: var(--color-bg-alt);
		padding: 3.5rem 1.5rem;
	}

	.featured-product-inner {
		max-width: 1100px;
		margin: 0 auto;
	}

	.eyebrow-mono {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin-bottom: 0.85rem;
	}

	.featured-product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.25rem;
	}

	.featured-product-card {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		background-color: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: 1.5rem 1.75rem;
		color: inherit;
	}

	.featured-product-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: rgba(var(--color-teal-rgb), 0.12);
		color: var(--color-teal);
	}

	.featured-product-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.featured-product-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.02rem;
		color: var(--color-text);
	}

	.featured-product-description {
		font-size: 0.88rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.featured-product-arrow {
		flex-shrink: 0;
		color: var(--color-teal);
		transition: transform 0.2s ease;
	}

	.featured-product-card:hover .featured-product-arrow,
	.featured-product-card:focus-visible .featured-product-arrow {
		transform: translateX(4px);
	}

	@media (max-width: 600px) {
		.featured-product {
			padding: 3rem 1.25rem;
		}

		.featured-product-card {
			flex-wrap: wrap;
			padding: 1.5rem;
		}

		.featured-product-arrow {
			display: none;
		}
	}

	/* How It Works */
	.product-how-it-works {
		background: var(--color-bg);
		padding: 5rem 1.5rem;
	}

	.product-how-it-works-inner {
		max-width: 1100px;
		margin: 0 auto;
	}

	.product-how-it-works h2 {
		text-align: center;
		font-size: 1.6rem;
		color: var(--color-text);
		margin: 0 0 2.5rem;
	}

	/* FAQ */
	.product-faq {
		background: var(--color-bg-alt);
		padding: 5rem 1.5rem;
	}

	.product-faq-inner {
		max-width: 760px;
		margin: 0 auto;
	}

	.product-faq h2 {
		text-align: center;
		font-size: 1.6rem;
		color: var(--color-text);
		margin: 0 0 2.5rem;
	}

	/* Comparison */
	.product-comparison {
		background: var(--color-bg);
		padding: 5rem 1.5rem;
	}

	.product-comparison-inner {
		max-width: 900px;
		margin: 0 auto;
	}

	.product-comparison h2 {
		text-align: center;
		font-size: 1.6rem;
		color: var(--color-text);
		margin: 0 0 2.5rem;
	}

	@media (max-width: 600px) {
		.product-how-it-works,
		.product-faq,
		.product-comparison {
			padding: 3.5rem 1.25rem;
		}
	}

	/* Closing CTA */
	.closing-cta {
		position: relative;
		background: var(--color-indigo);
		color: var(--color-ink);
		padding: 4.5rem 1.5rem;
		text-align: center;
		overflow: hidden;
		isolation: isolate;
	}

	.closing-cta-grid {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: repeating-linear-gradient(90deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px);
		mask-image: linear-gradient(to bottom, black, transparent);
	}

	.closing-cta-inner {
		max-width: 640px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.closing-cta h2 {
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin: 0;
	}

	.closing-cta p {
		font-size: 1rem;
		color: var(--color-ink-muted);
		margin: -0.75rem 0 0;
	}
</style>
