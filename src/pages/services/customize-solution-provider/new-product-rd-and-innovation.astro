---
import Layout from '../../../layouts/Layout.astro';
import HowItWorksFlow from '../../../components/product/HowItWorksFlow.astro';
import FaqAccordion from '../../../components/product/FaqAccordion.astro';
import ComparisonTable from '../../../components/product/ComparisonTable.astro';

// PLACEHOLDER CONTENT — this page follows the reference structure built for
// src/pages/product/iot/smart-key-management-system.astro. Copy below is
// generic, plausible placeholder text for a new product R&D and innovation
// service, pending real service details from Cavotec Malaysia.
//
// NOTE: this page is deliberately separate from src/pages/services/rd-service
// (the standalone R&D Service category page, moved here from
// src/pages/product/rd-service along with the rest of Services) per
// instruction — it is not
// merged or cross-linked with that page; it exists as its own sub-page
// under the Customize Solution Provider category.

const features = [
	'End-to-end new product development support',
	'Electronic, mechanical, and systems R&D expertise',
	'Prototyping and testing before final delivery',
	'Collaborative engagement tailored to your goals',
	'Support from concept through production-ready design',
];

const howItWorksSteps = [
	{
		label: 'Consultation',
		description: 'Discuss your product idea, goals, and requirements',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>',
	},
	{
		label: 'Concept & Design',
		description: 'Initial concepts and technical design are developed',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="6" height="6" rx="1" /><path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" /></svg>',
	},
	{
		label: 'Prototype & Test',
		description: 'A working prototype is built and tested',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" /><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5" /></svg>',
	},
	{
		label: 'Deliver',
		description: 'A production-ready design is finalized and delivered',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12" /></svg>',
	},
];

// PLACEHOLDER CONTENT — generic, plausible Q&As for a new product R&D
// service, pending real service details.
const faqs = [
	{
		question: 'What stage does a project need to be at to start?',
		answer: 'Any stage — from an early idea to a partially developed product, our team can help take it forward.',
	},
	{
		question: 'Do you build working prototypes?',
		answer: 'Yes — prototyping and testing are core parts of our R&D process before final delivery.',
	},
	{
		question: 'What kinds of products can you help develop?',
		answer:
			'Our team supports a range of product types, drawing on electronic, mechanical, and systems R&D expertise — contact us to discuss your specific idea.',
	},
	{
		question: 'How involved will we be during development?',
		answer: 'We work closely with customers throughout the engagement, with regular updates and check-ins.',
	},
	{
		question: 'Do you offer support after the product is delivered?',
		answer: 'Support options can be discussed as part of your project scope.',
	},
];

// PLACEHOLDER CONTENT — illustrative comparison rows pending confirmed
// service data.
const comparisonRows = [
	{ capability: 'Expertise', baseline: 'Limited to your team', cavotec: 'Electronic, mechanical, and systems R&D combined' },
	{ capability: 'Time to Prototype', baseline: 'Slower, self-directed', cavotec: 'Structured, experienced process' },
	{ capability: 'Risk', baseline: 'Higher, less experience', cavotec: 'Established development process' },
	{ capability: 'Resources', baseline: 'Must build in-house', cavotec: 'Access to existing capability' },
	{ capability: 'Flexibility', baseline: 'Fixed internal capacity', cavotec: 'Scoped to your project' },
];
---

<Layout
	title="New Product R&D and Innovation — Cavotec Malaysia Sdn Bhd"
	description="End-to-end research and development from Cavotec Malaysia, from concept through prototyping to production-ready design."
>
	<section class="page-header">
		<div class="page-header-grid" aria-hidden="true" data-parallax-bg></div>
		<div class="page-header-inner" data-reveal>
			<span class="eyebrow">Customize Solution Provider</span>
			<h1>New Product R&amp;D and Innovation</h1>
			<p class="product-tagline">
				End-to-end research and development for new products, from concept through prototyping to
				production-ready design.
			</p>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="product-overview">
		<div class="product-overview-inner">
			<div class="product-image-placeholder" data-reveal>
				<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="4" width="18" height="16" rx="2" />
					<circle cx="8.5" cy="9.5" r="1.5" />
					<path d="M21 16l-5.5-5.5a1.5 1.5 0 0 0-2.1 0L4 19" />
				</svg>
				<strong>New Product R&amp;D and Innovation</strong>
				<span>Product image — coming soon</span>
			</div>

			<div class="product-description" data-reveal style="--reveal-i: 1;">
				<h2>About the Service</h2>
				<p>
					Cavotec Malaysia's New Product R&amp;D and Innovation service supports customers through
					end-to-end research and development, from initial concept through prototyping to
					production-ready design. Our team draws on electronic, mechanical, and systems expertise
					to bring new ideas to life.
				</p>
				<p>
					Every engagement starts with understanding your goals and requirements, followed by
					design, prototyping, and testing before final delivery. We work closely with customers
					to make sure the end result meets both technical and commercial needs.
				</p>
				<p>
					Whether you're developing a completely new product or innovating on an existing one, our
					R&amp;D service is built to support you through each stage of the process.
				</p>

				<h3>Key Features</h3>
				<ul class="product-features">
					{features.map((feature) => (
						<li>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="12" cy="12" r="9" />
								<path d="M8 12.5l2.5 2.5L16 9" />
							</svg>
							<span>{feature}</span>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<!-- PLACEHOLDER CONTENT: the 4 steps below are illustrative — adjust
	     wording once real engagement workflow details are confirmed. -->
	<section class="product-how-it-works">
		<div class="product-how-it-works-inner">
			<h2 data-reveal>How It Works</h2>
			<HowItWorksFlow steps={howItWorksSteps} />
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<!-- PLACEHOLDER CONTENT: the 5 Q&As below are generic, plausible copy
	     pending real service specs — replace once confirmed. -->
	<section class="product-faq">
		<div class="product-faq-inner">
			<h2 data-reveal>Frequently Asked Questions</h2>
			<FaqAccordion faqs={faqs} />
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<!-- PLACEHOLDER CONTENT: the comparison rows below are illustrative,
	     pending confirmed service data. -->
	<section class="product-comparison">
		<div class="product-comparison-inner">
			<h2 data-reveal>Cavotec New Product R&amp;D vs. Going It Alone</h2>
			<ComparisonTable baselineLabel="Going It Alone" cavotecLabel="Cavotec New Product R&D" rows={comparisonRows} />
		</div>
	</section>

	<section class="closing-cta">
		<div class="closing-cta-grid" aria-hidden="true" data-parallax-bg></div>
		<div class="closing-cta-inner" data-reveal>
			<h2>Bring Your Next Product to Life</h2>
			<p>Discuss your project with our team and see how we can help.</p>
			<div class="product-cta-group">
				<a href="/contact?subject=New%20Product%20R%26D%20and%20Innovation" class="btn btn-accent">Discuss Your Project</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Page header — same recipe used on every other page; each page keeps
	   its own copy since this <style> block is scoped to this file. */
	.page-header {
		position: relative;
		background: linear-gradient(135deg, var(--color-indigo-dark) 0%, var(--color-indigo) 55%, var(--color-indigo-light) 100%);
		color: var(--color-ink);
		padding: 4.5rem 1.5rem 3.5rem;
		text-align: center;
		overflow: hidden;
		isolation: isolate;
	}

	.page-header-grid {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			repeating-linear-gradient(90deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px),
			repeating-linear-gradient(0deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px);
		mask-image: radial-gradient(ellipse at center, black 15%, transparent 75%);
	}

	.page-header-inner {
		max-width: 760px;
		margin: 0 auto;
		position: relative;
	}

	.eyebrow {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-amber);
		margin-bottom: 0.75rem;
	}

	.page-header h1 {
		font-size: clamp(2rem, 4.5vw, 2.75rem);
		font-weight: 700;
		margin: 0 0 0.85rem;
	}

	.product-tagline {
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--color-ink-muted);
		max-width: 56ch;
		margin: 0 auto;
	}

	/* Overview */
	.product-overview {
		background: var(--color-bg);
		padding: 5rem 1.5rem;
	}

	.product-overview-inner {
		max-width: 1100px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
		gap: 3rem;
		align-items: start;
	}

	.product-image-placeholder {
		aspect-ratio: 4 / 3;
		/* No explicit width — a grid item stretches to fill its column by
		   default; see the equivalent comment on the SKMS page for why
		   width: 100% here would overflow under content-box sizing. */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		text-align: center;
		padding: 1.5rem;
		color: var(--color-text-muted);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: repeating-linear-gradient(
			135deg,
			var(--color-indigo),
			var(--color-indigo) 10px,
			var(--color-surface) 10px,
			var(--color-surface) 20px
		);
		position: sticky;
		top: calc(var(--header-height) + 1.5rem);
	}

	.product-image-placeholder strong {
		font-size: 1rem;
		color: var(--color-text);
	}

	.product-image-placeholder span {
		font-size: 0.8rem;
	}

	.product-description h2 {
		font-size: 1.4rem;
		color: var(--color-text);
		margin: 0 0 1.25rem;
	}

	.product-description h3 {
		font-size: 1.05rem;
		color: var(--color-text);
		margin: 2rem 0 1rem;
	}

	.product-description p {
		font-size: 0.98rem;
		line-height: 1.75;
		color: var(--color-text-muted);
		margin: 0 0 1.25rem;
	}

	.product-features {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.product-features li {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.product-features svg {
		flex-shrink: 0;
		margin-top: 0.1rem;
		color: var(--color-teal);
	}

	.product-cta-group {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.85rem 2rem;
		border-radius: 4px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0.01em;
		border: none;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
	}

	.btn-accent {
		background: var(--color-teal);
		color: var(--color-on-accent);
		box-shadow: 0 6px 20px rgba(var(--color-teal-rgb), 0.35);
	}

	.btn-accent:hover,
	.btn-accent:focus-visible {
		background: #00d9eb;
		transform: translateY(-2px);
		box-shadow: 0 10px 26px rgba(var(--color-teal-rgb), 0.45);
	}

	@media (max-width: 860px) {
		.product-overview-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.product-image-placeholder {
			position: static;
			max-width: 380px;
			margin: 0 auto;
		}
	}

	@media (max-width: 600px) {
		.product-overview {
			padding: 3.5rem 1.25rem;
		}

		.product-cta-group {
			flex-direction: column;
			align-items: stretch;
		}

		.btn {
			justify-content: center;
		}
	}

	/* How It Works */
	.product-how-it-works {
		background: var(--color-bg-alt);
		padding: 5rem 1.5rem;
	}

	.product-how-it-works-inner {
		max-width: 1100px;
		margin: 0 auto;
	}

	.product-how-it-works h2 {
		text-align: center;
		font-size: 1.6rem;
		color: var(--color-text);
		margin: 0 0 2.5rem;
	}

	/* FAQ */
	.product-faq {
		background: var(--color-bg);
		padding: 5rem 1.5rem;
	}

	.product-faq-inner {
		max-width: 760px;
		margin: 0 auto;
	}

	.product-faq h2 {
		text-align: center;
		font-size: 1.6rem;
		color: var(--color-text);
		margin: 0 0 2.5rem;
	}

	/* Comparison */
	.product-comparison {
		background: var(--color-bg-alt);
		padding: 5rem 1.5rem;
	}

	.product-comparison-inner {
		max-width: 900px;
		margin: 0 auto;
	}

	.product-comparison h2 {
		text-align: center;
		font-size: 1.6rem;
		color: var(--color-text);
		margin: 0 0 2.5rem;
	}

	@media (max-width: 600px) {
		.product-how-it-works,
		.product-faq,
		.product-comparison {
			padding: 3.5rem 1.25rem;
		}
	}

	/* Closing CTA */
	.closing-cta {
		position: relative;
		background: var(--color-indigo);
		color: var(--color-ink);
		padding: 4.5rem 1.5rem;
		text-align: center;
		overflow: hidden;
		isolation: isolate;
	}

	.closing-cta-grid {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: repeating-linear-gradient(90deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px);
		mask-image: linear-gradient(to bottom, black, transparent);
	}

	.closing-cta-inner {
		max-width: 640px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.closing-cta h2 {
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin: 0;
	}

	.closing-cta p {
		font-size: 1rem;
		color: var(--color-ink-muted);
		margin: -0.75rem 0 0;
	}
</style>
