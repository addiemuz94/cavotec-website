---
import Layout from '../layouts/Layout.astro';
import { productCategories } from '../data/productCategories';
import BrandLogoChip from '../components/product/BrandLogoChip.astro';

// Rebuilt to exactly mirror the Products branch of ourBusinessMenu
// (Layout.astro) — this page had drifted stale (a hardcoded, unrelated
// "Minisonic MS20"-style catalog with no real hrefs) rather than reflecting
// the real nav. Now pulls from the same shared `productCategories` data
// index.astro's carousel and /our-business already use, so a future nav
// change only needs updating in one place instead of three.
//
// Order matches the live nav exactly: Test Equipment and Measurement
// Instrument (+ 4 brand children), ATE System, Internet of Things (IoT)
// (+ 3 product children). Note: "Repair Work Service" and "R&D Service"
// are NOT part of the Products branch in the actual nav data — both belong
// to Services (as "Repair Work" and, nested under Customize Solution
// Provider, "New Product R&D and Innovation") — so they're correctly
// excluded here despite appearing in this task's initial description.
---

<Layout
	title="Products — Cavotec Malaysia Sdn Bhd"
	description="Cavotec Malaysia's product lines — ATE System, Internet of Things (IoT), and our Test Equipment and Measurement Instrument brands."
>
	<section class="page-header">
		<div class="page-header-grid" aria-hidden="true" data-parallax-bg></div>
		<div class="page-header-inner" data-reveal>
			<span class="eyebrow">Our Catalog</span>
			<h1>Products</h1>
			<p class="page-tagline">Our product lines, and the brands we bring in alongside them.</p>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="products-section">
		<div class="products-section-inner">
			<div class="product-groups">
				{
					productCategories.map((category, index) => (
						<div class="product-group" data-reveal style={`--reveal-i: ${index};`}>
							<a href={category.href} class="summary-card tech-card" data-shine>
								<span class="summary-card-icon" aria-hidden="true" set:html={category.iconSvg} />
								<h3>{category.title}</h3>
								<p>{category.description}</p>
							</a>

							{/* Test Equipment's 4 brand children: a compact row of logo
							    chips (already built for nav/brand pages) rather than a
							    full card each — brands are logo-forward, not
							    description-forward, at this summary-page scale. */}
							{category.children && category.children.some((child) => child.logo) && (
								<div class="brand-chip-row">
									{category.children.map((child) => (
										<a href={child.href} class="brand-chip-link">
											<BrandLogoChip src={child.logo!} alt={child.logoAlt ?? `${child.title} logo`} size="nav" variant={child.logoChipVariant} />
											<span>{child.title}</span>
										</a>
									))}
								</div>
							)}

							{/* IoT's 3 product children have no logo art — grouped the
							    same way /product/iot/ itself groups them: a grid of
							    small text sub-cards, not a compact chip list. */}
							{category.children && !category.children.some((child) => child.logo) && (
								<div class="child-subgrid">
									{category.children.map((child) => (
										<a href={child.href} class="child-subcard">
											<h4>{child.title}</h4>
											<p>{child.description}</p>
										</a>
									))}
								</div>
							)}
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="closing-cta">
		<div class="closing-cta-grid" aria-hidden="true" data-parallax-bg></div>
		<div class="closing-cta-inner" data-reveal>
			<h2>Looking for a Specific Product?</h2>
			<p>Get in touch and our team will help you find the right fit.</p>
			<div class="product-cta-group">
				<a href="/contact" class="btn btn-accent">Get in Touch</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Page header — same recipe used on every other page; each page keeps
	   its own copy since this <style> block is scoped to this file. */
	.page-header {
		position: relative;
		background: linear-gradient(135deg, var(--color-indigo-dark) 0%, var(--color-indigo) 55%, var(--color-indigo-light) 100%);
		color: var(--color-ink);
		padding: 4.5rem 1.5rem 3.5rem;
		text-align: center;
		overflow: hidden;
		isolation: isolate;
	}

	.page-header-grid {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			repeating-linear-gradient(90deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px),
			repeating-linear-gradient(0deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px);
		mask-image: radial-gradient(ellipse at center, black 15%, transparent 75%);
	}

	.page-header-inner {
		max-width: 760px;
		margin: 0 auto;
		position: relative;
	}

	.eyebrow {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-amber);
		margin-bottom: 0.75rem;
	}

	.page-header h1 {
		font-size: clamp(2rem, 4.5vw, 2.75rem);
		font-weight: 700;
		margin: 0 0 0.85rem;
	}

	.page-tagline {
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--color-ink-muted);
		max-width: 56ch;
		margin: 0 auto;
	}

	.products-section {
		background: var(--color-bg);
		padding: 5rem 1.5rem;
	}

	.products-section-inner {
		max-width: 900px;
		margin: 0 auto;
	}

	.product-groups {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.product-group {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	/* Top-level category card — visually copied from /services' and
	   /our-business's .summary-card (icon circle + heading + paragraph),
	   not a new card style. */
	.summary-card {
		/* background-color, not the background shorthand — [data-shine]'s own
		   background-image (see Layout.astro) needs that slot left alone. */
		background-color: var(--color-bg-alt);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: 2rem 1.75rem;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
		color: inherit;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.summary-card-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: rgba(var(--color-teal-rgb), 0.12);
		color: var(--color-teal);
		margin-bottom: 1rem;
	}

	.summary-card-icon :global(svg) {
		width: 24px;
		height: 24px;
	}

	.summary-card h3 {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-ink);
		margin: 0 0 0.5rem;
	}

	.summary-card p {
		font-size: 0.9rem;
		line-height: 1.65;
		color: var(--color-text-muted);
		margin: 0;
	}

	/* Test Equipment's brand children — a compact wrapped row of logo chips
	   + label, sitting under the parent summary card. */
	.brand-chip-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding-left: 0.25rem;
	}

	.brand-chip-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.5rem 0.85rem 0.5rem 0.5rem;
		background-color: var(--color-bg-alt);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-text);
		transition: border-color 0.2s ease, transform 0.15s ease;
	}

	.brand-chip-link:hover,
	.brand-chip-link:focus-visible {
		border-color: var(--color-teal);
		transform: translateY(-1px);
	}

	/* IoT's product children — a grid of small text sub-cards, matching how
	   /product/iot/ itself groups them (a "Products" grid of cards beneath
	   the category's own hero), just at a more compact scale here. */
	.child-subgrid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
		padding-left: 0.25rem;
	}

	.child-subcard {
		background-color: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 10px;
		padding: 1.25rem 1.35rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		color: inherit;
		transition: border-color 0.2s ease, transform 0.15s ease;
	}

	.child-subcard:hover,
	.child-subcard:focus-visible {
		border-color: var(--color-teal);
		transform: translateY(-1px);
	}

	.child-subcard h4 {
		font-family: var(--font-display);
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--color-text);
		margin: 0;
	}

	.child-subcard p {
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--color-text-muted);
		margin: 0;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.85rem 2rem;
		border-radius: 4px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0.01em;
		border: none;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
	}

	.btn-accent {
		background: var(--color-teal);
		color: var(--color-on-accent);
		box-shadow: 0 6px 20px rgba(var(--color-teal-rgb), 0.35);
	}

	.btn-accent:hover,
	.btn-accent:focus-visible {
		background: #00d9eb;
		transform: translateY(-2px);
		box-shadow: 0 10px 26px rgba(var(--color-teal-rgb), 0.45);
	}

	/* Closing CTA */
	.closing-cta {
		position: relative;
		background: var(--color-indigo);
		color: var(--color-ink);
		padding: 4.5rem 1.5rem;
		text-align: center;
		overflow: hidden;
		isolation: isolate;
	}

	.closing-cta-grid {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: repeating-linear-gradient(90deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px);
		mask-image: linear-gradient(to bottom, black, transparent);
	}

	.closing-cta-inner {
		max-width: 640px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.closing-cta h2 {
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin: 0;
	}

	.closing-cta p {
		font-size: 1rem;
		color: var(--color-ink-muted);
		margin: -0.75rem 0 0;
	}

	@media (max-width: 640px) {
		.page-header {
			padding: 3.5rem 1.25rem 2.75rem;
		}

		.products-section {
			padding: 3.5rem 1.25rem;
		}
	}
</style>
