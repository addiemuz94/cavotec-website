---
import Layout from '../layouts/Layout.astro';

const services = [
	{
		title: 'Test and Measurement Solutions',
		icon: 'gauge',
	},
	{
		title: 'Telecommunication Equipment',
		icon: 'tower',
	},
	{
		title: 'RF, Microwave & Radio Accessories',
		icon: 'signal',
	},
	{
		title: 'Test Equipment Repair, Calibration and Training',
		icon: 'wrench',
	},
	{
		title: 'Test Equipment Rental',
		icon: 'clock',
	},
];

// Hero background crossfade — filenames only; the images themselves are
// dropped into public/images/hero/ later. Kept as a plain array so adding a
// 5th image later is a one-line change here (see the cycling script below).
const heroBackgrounds = [
	'/images/hero/hero-bg-1.jpg',
	'/images/hero/hero-bg-2.jpg',
	'/images/hero/hero-bg-3.jpg',
	'/images/hero/hero-bg-4.jpg',
];

// "By the numbers" stats strip — general capability stats only, no
// certification/accreditation claims (those live on the Services page).
const stats = [
	{ value: '10+', label: 'Years of Technical Expertise' },
	{ value: '2,400+', label: 'Manufacturers Supported' },
	{ value: '5', label: 'Core Service Areas' },
	{ value: '24/7', label: 'Equipment Support Availability' },
];
---

<Layout
	title="Cavotec Malaysia Sdn Bhd — Test & Measurement Solutions"
	description="Cavotec Malaysia Sdn Bhd provides test and measurement solutions, telecommunication equipment, RF & microwave accessories, repair, calibration, training and rental services."
>
	<section class="hero">
		<!-- Cycling backdrop: plain crossfading layers behind the oscilloscope
		     grid and the dark overlay, so it reads as mood/texture rather than
		     content. Cycling is driven by the vanilla-JS loop below; with no
		     JS (or prefers-reduced-motion) the first image is simply static. -->
		<div class="hero-bg" aria-hidden="true" data-hero-bg>
			{heroBackgrounds.map((src, index) => (
				<div class:list={['hero-bg-image', { 'is-active': index === 0 }]} style={`background-image: url(${src});`}></div>
			))}
		</div>
		<!-- No [data-parallax-bg]: the hero owns this element's transform
		     itself (see the cursor/tilt parallax script below), which folds
		     in the same scroll-drift the shared Layout.astro treatment gives
		     every other page's header/hero, so nothing fights over
		     style.transform. -->
		<div class="hero-grid" aria-hidden="true"></div>
		<div class="hero-overlay" aria-hidden="true"></div>
		<div class="hero-inner">
			<div class="hero-content">
				<h1 data-reveal>Welcome to Cavotec Malaysia Sdn Bhd</h1>
				<p class="hero-subheading" data-reveal style="--reveal-i: 1;">
					Home for repair and services of your favorite test and measurement equipment
				</p>
				<a href="/services" class="btn btn-accent" data-reveal style="--reveal-i: 2;">Learn More</a>
			</div>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="stats-strip">
		<div class="stats-strip-inner">
			<span class="stats-eyebrow" data-reveal>By the Numbers</span>
			<ul class="stats-grid">
				{stats.map((stat, index) => (
					<li class="stat-item" data-reveal style={`--reveal-i: ${index + 1};`}>
						<span class="stat-number spec-mono" data-value={stat.value}>{stat.value}</span>
						<span class="stat-label">{stat.label}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="services">
		<div class="services-inner">
			<h2 data-reveal>List of Services Offered</h2>
			<div class="services-grid">
				{services.map((service, index) => (
					<div class="service-card tech-card" data-shine data-reveal style={`--reveal-i: ${index};`}>
						<span class="service-icon" aria-hidden="true">
							{service.icon === 'gauge' && (
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 21a9 9 0 1 0-9-9" />
									<path d="M12 21a9 9 0 0 0 9-9" />
									<path d="M12 12L16 8" />
									<circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none" />
								</svg>
							)}
							{service.icon === 'tower' && (
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 2l7 20M12 2L5 22" />
									<path d="M8.5 12h7M6.5 17h11" />
									<path d="M12 2v4" />
								</svg>
							)}
							{service.icon === 'signal' && (
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M4 12a8 8 0 0 1 16 0" />
									<path d="M7.5 12a4.5 4.5 0 0 1 9 0" />
									<circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none" />
									<path d="M12 13.3V19" />
								</svg>
							)}
							{service.icon === 'wrench' && (
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M14.7 6.3a4 4 0 0 0-5.4 4.6L4 16.2V20h3.8l5.3-5.3a4 4 0 0 0 4.6-5.4l-2.6 2.6-2-2 2.6-2.6z" />
								</svg>
							)}
							{service.icon === 'clock' && (
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="9" />
									<path d="M12 7v5l3.5 2" />
								</svg>
							)}
						</span>
						<h3>{service.title}</h3>
					</div>
				))}
			</div>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="closing-cta">
		<div class="closing-cta-grid" aria-hidden="true" data-parallax-bg></div>
		<div class="closing-cta-inner" data-reveal>
			<h2>Need High Quality Services? Call Us!</h2>
			<a href="/contact" class="btn btn-warm">Get in Touch</a>
		</div>
	</section>
</Layout>

<script>
	// "By the numbers" count-up. Follows the same intersection + reduced-motion
	// pattern as the scroll-reveal in Layout.astro: default to the final value
	// (server-rendered) so nothing ever gets stuck at 0, and only animate when
	// motion is allowed and the section actually scrolls into view.
	const statNumbers = document.querySelectorAll('.stat-number[data-value]');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function zeroState(value: string) {
		// Preserve everything but the leading digit run, e.g. "2,400+" -> "0+",
		// "24/7" -> "0/7", "5" -> "0".
		const match = value.match(/^([\d,]+)(.*)$/);
		if (!match) return value;
		return `0${match[2]}`;
	}

	function animateCount(el: Element) {
		const target = el.getAttribute('data-value') ?? '';
		const match = target.match(/^([\d,]+)(.*)$/);
		if (!match) return;
		const [, digits, suffix] = match;
		const endValue = parseInt(digits.replace(/,/g, ''), 10);
		const duration = 1400;
		const start = performance.now();

		function tick(now: number) {
			const progress = Math.min((now - start) / duration, 1);
			const eased = 1 - Math.pow(1 - progress, 3);
			const current = Math.round(endValue * eased);
			el.textContent = `${current.toLocaleString('en-US')}${suffix}`;
			if (progress < 1) {
				requestAnimationFrame(tick);
			} else {
				el.textContent = target;
			}
		}

		requestAnimationFrame(tick);
	}

	if (!prefersReducedMotion && 'IntersectionObserver' in window && statNumbers.length) {
		statNumbers.forEach((el) => {
			const value = el.getAttribute('data-value');
			if (value) el.textContent = zeroState(value);
		});

		const statsObserver = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						animateCount(entry.target);
						statsObserver.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.4 }
		);

		statNumbers.forEach((el) => statsObserver.observe(el));
	}
	// If motion is reduced or IntersectionObserver is unavailable, the
	// server-rendered final values (e.g. "10+") are left exactly as-is.

	// Hero background crossfade — cycles the stacked .hero-bg-image layers by
	// toggling `is-active` (the fade itself is a CSS transition, see below).
	// Reduced motion: leave the first image as the single static backdrop.
	// Off-screen: pause the interval rather than cycling unseen.
	class HeroBackgroundCycler {
		private images: HTMLElement[];
		private index = 0;
		private timer: number | null = null;
		private readonly intervalMs = 7000;

		constructor(root: HTMLElement) {
			this.images = Array.from(root.querySelectorAll<HTMLElement>('.hero-bg-image'));
		}

		private advance = () => {
			if (this.images.length < 2) return;
			this.images[this.index].classList.remove('is-active');
			this.index = (this.index + 1) % this.images.length;
			this.images[this.index].classList.add('is-active');
		};

		start() {
			if (this.timer !== null || this.images.length < 2) return;
			this.timer = window.setInterval(this.advance, this.intervalMs);
		}

		stop() {
			if (this.timer === null) return;
			window.clearInterval(this.timer);
			this.timer = null;
		}
	}

	const heroSection = document.querySelector<HTMLElement>('.hero');
	const heroBgRoot = document.querySelector<HTMLElement>('[data-hero-bg]');

	if (!prefersReducedMotion && heroSection && heroBgRoot) {
		const cycler = new HeroBackgroundCycler(heroBgRoot);

		if ('IntersectionObserver' in window) {
			const heroBgObserver = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							cycler.start();
						} else {
							cycler.stop();
						}
					}
				},
				{ threshold: 0 }
			);
			heroBgObserver.observe(heroSection);
		} else {
			cycler.start();
		}
	}
	// If motion is reduced, .hero-bg-image:first-child keeps its server-
	// rendered `is-active` class and every other layer stays at opacity 0 —
	// a complete, valid static backdrop, no JS required.

	// Hero background parallax — the oscilloscope-grid texture drifts a few
	// pixels toward the cursor (desktop) or device tilt (touch), eased with
	// a lerp so it reads as an ambient, instrument-panel-like response
	// rather than a flashy effect. Confined entirely to this decorative
	// layer: the heading/subtext/button live in .hero-inner, which this
	// class never touches, so they stay fixed and fully readable. Folds in
	// the same scroll-based drift Layout.astro's shared [data-parallax-bg]
	// gives every other page's header — .hero-grid deliberately opts out of
	// that attribute (see the markup above) so this class is the sole owner
	// of its transform instead of two scripts fighting over the property.
	class HeroParallax {
		private readonly hero: HTMLElement;
		private readonly grid: HTMLElement;
		private readonly maxOffset = 60; // px — pushed further again after 40px/0.5 still read as too subtle
		private readonly ease = 0.08; // lerp factor per frame toward the target
		private targetX = 0;
		private targetY = 0;
		private currentX = 0;
		private currentY = 0;
		private scrollOffsetY = 0;
		private rafId: number | null = null;
		private visible = true;
		private readonly controller = new AbortController();

		constructor(hero: HTMLElement, grid: HTMLElement) {
			this.hero = hero;
			this.grid = grid;
		}

		start() {
			const { signal } = this.controller;
			const supportsHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

			if (supportsHover) {
				this.hero.addEventListener('pointermove', this.handlePointerMove, { passive: true, signal });
				this.hero.addEventListener('pointerleave', this.handlePointerLeave, { passive: true, signal });
			} else if (typeof DeviceOrientationEvent !== 'undefined') {
				this.attachOrientation(signal);
			}
			// No hover-capable pointer and no orientation support: targetX/Y
			// simply never move, so the grid stays static — never an error.

			window.addEventListener('scroll', this.updateScrollOffset, { passive: true, signal });
			window.addEventListener('resize', this.updateScrollOffset, { passive: true, signal });
			this.updateScrollOffset();

			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							this.visible = entry.isIntersecting;
							if (this.visible) this.wake();
						}
					},
					{ threshold: 0 }
				);
				observer.observe(this.hero);
				signal.addEventListener('abort', () => observer.disconnect());
			}
		}

		destroy() {
			this.controller.abort();
			if (this.rafId !== null) cancelAnimationFrame(this.rafId);
			this.rafId = null;
		}

		private attachOrientation(signal: AbortSignal) {
			const requestPermission = (
				DeviceOrientationEvent as unknown as { requestPermission?: () => Promise<string> }
			).requestPermission;

			if (typeof requestPermission === 'function') {
				// iOS 13+ gates orientation behind an explicit permission grant,
				// which in turn normally requires an active user gesture to
				// resolve as "granted". There's no gesture here, so this either
				// silently succeeds (already granted) or rejects — either way
				// the grid just stays static instead of throwing.
				requestPermission()
					.then((state) => {
						if (state === 'granted') {
							window.addEventListener('deviceorientation', this.handleOrientation, { passive: true, signal });
						}
					})
					.catch(() => {});
			} else {
				window.addEventListener('deviceorientation', this.handleOrientation, { passive: true, signal });
			}
		}

		private clamp(value: number, min: number, max: number) {
			return Math.min(Math.max(value, min), max);
		}

		private handlePointerMove = (event: PointerEvent) => {
			const rect = this.hero.getBoundingClientRect();
			const relX = (event.clientX - rect.left) / rect.width - 0.5;
			const relY = (event.clientY - rect.top) / rect.height - 0.5;
			this.targetX = this.clamp(relX * this.maxOffset * 2, -this.maxOffset, this.maxOffset);
			this.targetY = this.clamp(relY * this.maxOffset * 2, -this.maxOffset, this.maxOffset);
			this.wake();
		};

		private handlePointerLeave = () => {
			this.targetX = 0;
			this.targetY = 0;
			this.wake();
		};

		private handleOrientation = (event: DeviceOrientationEvent) => {
			if (event.beta === null || event.gamma === null) return;
			const tiltX = this.clamp(event.gamma, -25, 25);
			const tiltY = this.clamp(event.beta - 45, -25, 25); // ~45° = phone held naturally, treated as centered
			this.targetX = (tiltX / 25) * this.maxOffset;
			this.targetY = (tiltY / 25) * this.maxOffset;
			this.wake();
		};

		private updateScrollOffset = () => {
			this.scrollOffsetY = this.hero.getBoundingClientRect().top * 0.12;
			this.wake();
		};

		private wake() {
			if (this.rafId === null && this.visible) {
				this.rafId = requestAnimationFrame(this.tick);
			}
		}

		private tick = () => {
			this.currentX += (this.targetX - this.currentX) * this.ease;
			this.currentY += (this.targetY - this.currentY) * this.ease;
			this.grid.style.transform = `translate3d(${this.currentX.toFixed(2)}px, ${(this.currentY + this.scrollOffsetY).toFixed(2)}px, 0)`;

			const settled = Math.abs(this.targetX - this.currentX) < 0.05 && Math.abs(this.targetY - this.currentY) < 0.05;

			if (this.visible && !settled) {
				this.rafId = requestAnimationFrame(this.tick);
			} else {
				this.rafId = null;
			}
		};
	}

	const heroGridEl = document.querySelector<HTMLElement>('.hero-grid');

	if (!prefersReducedMotion && heroSection && heroGridEl) {
		const parallax = new HeroParallax(heroSection, heroGridEl);
		parallax.start();

		// Defensive cleanup for client-side page navigation — a no-op today
		// since this site doesn't run Astro's View Transitions router (each
		// navigation is a full page load, which discards listeners/rAF for
		// free), but keeps this safe to adopt later without leaking either.
		document.addEventListener('astro:before-swap', () => parallax.destroy(), { once: true });
		window.addEventListener('pagehide', () => parallax.destroy(), { once: true });
	}
	// If motion is reduced, .hero-grid keeps its default (untransformed)
	// position — fully static, exactly like every other page's
	// [data-parallax-bg] texture under reduced motion.
</script>

<style>
	section {
		width: 100%;
	}

	.btn {
		display: inline-block;
		padding: 0.85rem 2rem;
		border-radius: 4px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0.01em;
		transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
	}

	.btn-accent {
		background: var(--color-teal);
		color: var(--color-indigo);
		box-shadow: 0 6px 20px rgba(var(--color-teal-rgb), 0.35);
	}

	.btn-accent:hover,
	.btn-accent:focus-visible {
		background: #00d9eb;
		transform: translateY(-2px);
		box-shadow: 0 10px 26px rgba(var(--color-teal-rgb), 0.45);
	}

	/* Warm, customer-facing CTA — the one place amber takes the lead */
	.btn-warm {
		background: var(--color-amber);
		color: var(--color-indigo);
		box-shadow: 0 6px 20px rgba(var(--color-amber-rgb), 0.35);
	}

	.btn-warm:hover,
	.btn-warm:focus-visible {
		background: #ffb85e;
		transform: translateY(-2px);
		box-shadow: 0 10px 26px rgba(var(--color-amber-rgb), 0.45);
	}

	/* Hero */
	.hero {
		position: relative;
		background: linear-gradient(135deg, var(--color-indigo-dark) 0%, var(--color-indigo) 55%, var(--color-indigo-light) 100%);
		color: var(--color-ink);
		padding: 6.5rem 1.5rem;
		text-align: center;
		overflow: hidden;
		isolation: isolate;
	}

	/* Faint oscilloscope-style grid texture. Line opacity bumped from the
	   0.08–0.09 used on every other page's static header/hero grid, and the
	   radial mask widened — this is the one grid texture on the site that
	   carries the cursor/tilt parallax (see script below). Confirmed via an
	   exaggerated sanity check (80px offset, 0.6 opacity, temporary debug
	   border, mask disabled) that the transform pipeline itself was never
	   the problem — the movement was real and measurable at every value
	   tried; it just wasn't *visible* at the original 9%-opacity, tightly
	   masked settings. This is a perceptibility tuning value, not a hack. */
	.hero-grid {
		position: absolute;
		inset: 0;
		z-index: -2;
		background-image:
			repeating-linear-gradient(90deg, rgba(var(--color-teal-rgb), 0.7) 0 1px, transparent 1px 48px),
			repeating-linear-gradient(0deg, rgba(var(--color-teal-rgb), 0.7) 0 1px, transparent 1px 48px);
		mask-image: radial-gradient(ellipse at center, black 25%, transparent 100%);
	}

	.hero-inner {
		max-width: 1100px;
		margin: 0 auto;
		position: relative;
	}

	.hero-content {
		max-width: 620px;
		margin: 0 auto;
	}

	.hero h1 {
		font-size: clamp(2rem, 4.5vw, 3rem);
		font-weight: 700;
		line-height: 1.2;
		margin: 0 0 1.25rem;
	}

	.hero-subheading {
		font-size: clamp(1rem, 2vw, 1.25rem);
		color: var(--color-ink-muted);
		line-height: 1.6;
		margin: 0 0 2.25rem;
	}

	/* Cycling backdrop — stacked, absolutely-positioned layers crossfade via
	   opacity transitions (class-toggled by the vanilla-JS loop below). Sits
	   behind both the oscilloscope grid (.hero-grid) and the dark overlay
	   (.hero-overlay), so it always reads as a subtle, moody backdrop rather
	   than competing with the heading/subtext/button in front. */
	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: -3;
	}

	.hero-bg-image {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		opacity: 0;
		transition: opacity 1.8s ease;
	}

	.hero-bg-image.is-active {
		opacity: 1;
	}

	/* Dark indigo wash over the cycling images/grid texture — keeps heading,
	   subtext and button fully readable regardless of what the backdrop
	   image looks like. */
	.hero-overlay {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: rgba(var(--color-indigo-rgb), 0.85);
	}

	/* "By the numbers" stats strip — bg-alt (base black) sits between the
	   hero and the services section (elevated surface), alternating the
	   site's two dark tones the same way bg/bg-alt alternated light tones
	   before the black retheme. */
	.stats-strip {
		background: var(--color-bg-alt);
		padding: 3.5rem 1.5rem;
	}

	.stats-strip-inner {
		max-width: 1100px;
		margin: 0 auto;
		text-align: center;
	}

	.stats-eyebrow {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-amber-dark);
		margin-bottom: 2rem;
	}

	.stats-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem 1.5rem;
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
	}

	.stat-number {
		font-size: clamp(2.1rem, 4.5vw, 2.9rem);
		font-weight: 600;
		line-height: 1;
		color: var(--color-teal-dark, #018b96);
	}

	.stat-label {
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		color: var(--color-ink);
		max-width: 18ch;
	}

	/* Services */
	.services {
		background: var(--color-bg);
		padding: 5rem 1.5rem;
	}

	.services-inner {
		max-width: 1200px;
		margin: 0 auto;
	}

	.services h2 {
		text-align: center;
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		color: var(--color-ink);
		margin: 0 0 3rem;
		position: relative;
	}

	.services h2::after {
		content: '';
		display: block;
		width: 64px;
		height: 3px;
		background: var(--color-teal);
		margin: 0.9rem auto 0;
		border-radius: 2px;
	}

