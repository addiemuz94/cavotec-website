---
import Layout from '../layouts/Layout.astro';
import ShowcaseCarousel, { type ShowcaseItem } from '../components/ShowcaseCarousel.astro';
import HoloPreviewPanel from '../components/HoloPreviewPanel.astro';
import CustomerLogoGrid from '../components/CustomerLogoGrid.astro';
import { productCategories } from '../data/productCategories';
import { customers } from '../data/customers';

// ATE System's and Test Equipment and Measurement Instrument's carousel
// summaries below are both pulled from productCategories (also used by
// /our-business's Products section) rather than a second hand-copied
// string, so the pages can't drift apart on this text.
const ateSystemCategory = productCategories.find((category) => category.id === 'ate-system')!;
const testEquipmentCategory = productCategories.find((category) => category.id === 'test-equipment-measurement')!;

// PLACEHOLDER CONTENT — working set for the homepage showcase carousel,
// pulled from the actual product/service pages already built. One card per
// item rather than expanding "Customize Solution Provider" into its 3
// sub-services (electronic design / 3D design / R&D) — keeps the carousel
// at a manageable 10 cards; its own page links out to those sub-services.
// Order groups Products first (Test Equipment and Measurement Instrument,
// ATE System, then IoT's 3 sub-items — matching ourBusinessMenu's current
// Products order in Layout.astro), then Services. Final product/service
// list, taglines, and icons to be confirmed later.
//
// `image` is intentionally omitted on every item below — there are no real
// product/service photos in the repo yet (only the hero background set).
// HoloPreviewPanel renders its wireframe-glyph fallback for any item without
// an `image`, so right now every card shows that fallback; drop in a real
// photo path here per item as photos become available and the panel picks
// it up automatically, no other changes needed.
const showcaseItems: ShowcaseItem[] = [
	{
		href: testEquipmentCategory.href,
		title: testEquipmentCategory.title,
		tagline: 'Curated test equipment and measurement brands',
		summary: testEquipmentCategory.description,
		iconSvg: testEquipmentCategory.iconSvg,
	},
	{
		href: '/product/calibration-test-measurement/',
		title: 'ATE System',
		tagline: 'Automated functional and parametric testing',
		summary: ateSystemCategory.description,
		iconSvg:
			'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="6" height="6" rx="1" /><path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" /></svg>',
	},
	{
		href: '/product/iot/smart-key-management-system',
		title: 'Smart Key Management System',
		tagline: 'Secure, trackable key access control',
		summary:
			'A secure, trackable system for managing physical key access across facilities and fleets. Every checkout and return is logged automatically, removing the guesswork over who holds what and when, and it integrates with existing access-control and IoT monitoring setups.',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4" /></svg>',
	},
	{
		href: '/product/iot/integrated-alarm-system',
		title: 'Integrated Alarm System',
		tagline: 'Centralized monitoring and instant alerts',
		summary:
			'Centralized monitoring that pulls alerts from across a site into a single, actionable view. Instant notifications flag issues the moment they are detected, cutting response time, and the system scales from a single building to a full multi-site deployment.',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>',
	},
	{
		href: '/product/iot/bms',
		title: 'Smart Building Management System',
		tagline: 'Monitor and manage your building systems',
		summary:
			'Monitor and manage HVAC, power, lighting, and security from one connected dashboard. Real-time data surfaces inefficiencies before they become costly problems, and the system fits both new builds and retrofits of existing infrastructure.',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1" /><path d="M9 21v-4h6v4" /><path d="M8 7h2M14 7h2M8 11h2M14 11h2" /></svg>',
	},
	{
		href: '/services/calibration-test-measurement/',
		title: 'Calibration and Test Measurement',
		tagline: 'Precision calibration for test equipment',
		summary:
			'Precision calibration services that keep test and measurement equipment within spec and traceable to recognized standards. Coverage spans a broad range of instruments, from RF and microwave gear to general electronic test equipment, so drift gets caught before it gets costly.',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21a9 9 0 1 0-9-9" /><path d="M12 21a9 9 0 0 0 9-9" /><path d="M12 12L16 8" /><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none" /></svg>',
	},
	{
		href: '/services/repair-work/',
		title: 'Repair Work',
		tagline: 'Expert repair for test and measurement gear',
		summary:
			'Expert repair services for test and measurement equipment, from routine maintenance to complex fault diagnosis. Experienced technicians restore instruments to full manufacturer specification, with turnaround built around minimizing downtime for critical gear.',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 4.6L4 16.2V20h3.8l5.3-5.3a4 4 0 0 0 4.6-5.4l-2.6 2.6-2-2 2.6-2.6z" /></svg>',
	},
	{
		href: '/services/equipment-rental/',
		title: 'Equipment Rental',
		tagline: 'Calibrated equipment, ready when you need it',
		summary:
			'Calibrated test equipment available on flexible rental terms, ready to deploy the moment a project needs it. Avoid the capital cost of specialized gear that is only needed occasionally — every unit ships calibrated and verified before it reaches you.',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></svg>',
	},
	{
		href: '/services/training/',
		title: 'Training',
		tagline: 'Hands-on training for your technical team',
		summary:
			'Hands-on training programs built to bring technical teams up to speed on test and measurement equipment and practices. Sessions combine practical exercises with real-world troubleshooting scenarios, tailored to the equipment and skill level of each team.',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3L2 8l10 5 10-5-10-5z" /><path d="M6 10.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-5.5" /><path d="M22 8v6" /></svg>',
	},
	{
		href: '/services/customize-solution-provider/',
		title: 'Customize Solution Provider',
		tagline: 'Tailored electronic and 3D design services',
		summary:
			'Tailored electronic and 3D design services for teams that need a solution built around their exact requirements. Coverage spans schematic and PCB design through mechanical enclosures and prototyping, backed by an in-house R&D and innovation process.',
		iconSvg:
			'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h10M4 12h16M4 18h7" /><circle cx="17" cy="6" r="2" /><circle cx="9" cy="12" r="2" /><circle cx="14" cy="18" r="2" /></svg>',
	},
];

// Hero background crossfade — filenames only; the images themselves are
// dropped into public/images/hero/ later. Kept as a plain array so adding a
// 5th image later is a one-line change here (see the cycling script below).
const heroBackgrounds = [
	'/images/hero/hero-bg-1.jpg',
	'/images/hero/hero-bg-2.jpg',
	'/images/hero/hero-bg-3.jpg',
	'/images/hero/hero-bg-4.jpg',
];

---

<Layout
	title="Cavotec Malaysia Sdn Bhd — Test & Measurement Solutions"
	description="Cavotec Malaysia Sdn Bhd provides test and measurement solutions, telecommunication equipment, RF & microwave accessories, repair, calibration, training and rental services."
>
	<section class="hero">
		<!-- Cycling backdrop: plain crossfading layers behind the oscilloscope
		     grid and the dark overlay, so it reads as mood/texture rather than
		     content. Cycling is driven by the vanilla-JS loop below; with no
		     JS (or prefers-reduced-motion) the first image is simply static. -->
		<div class="hero-bg" aria-hidden="true" data-hero-bg>
			{heroBackgrounds.map((src, index) => (
				<div class:list={['hero-bg-image', { 'is-active': index === 0 }]} style={`background-image: url(${src});`}></div>
			))}
		</div>
		<!-- No [data-parallax-bg]: the hero owns this element's transform
		     itself (see the cursor/tilt parallax script below), which folds
		     in the same scroll-drift the shared Layout.astro treatment gives
		     every other page's header/hero, so nothing fights over
		     style.transform. -->
		<div class="hero-grid" aria-hidden="true"></div>
		<div class="hero-overlay" aria-hidden="true"></div>
		<div class="hero-inner">
			<div class="hero-content">
				<h1 data-reveal>Welcome to Cavotec Malaysia Sdn Bhd</h1>
				<p class="hero-subheading" data-reveal style="--reveal-i: 1;">
					Home for repair and services of your favorite test and measurement equipment
				</p>
				<a href="/our-business" class="btn btn-accent" data-reveal style="--reveal-i: 2;">Learn More</a>
			</div>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<ShowcaseCarousel items={showcaseItems} />

	<div class="tick-divider" aria-hidden="true"></div>

	<HoloPreviewPanel items={showcaseItems} />

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="closing-cta">
		<div class="closing-cta-grid" aria-hidden="true" data-parallax-bg></div>
		<div class="closing-cta-inner" data-reveal>
			<h2>Need High Quality Services? Call Us!</h2>
			<a href="/contact" class="btn btn-warm">Get in Touch</a>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<!-- "Our Customers" — see data/customers.ts for the placeholder-content
	     note (real logos + display permission both still pending from Adi).
	     Heading/intro copy below is placeholder wording, not final. -->
	<section class="customers-section">
		<div class="customers-section-inner">
			<h2 data-reveal>Our Customers</h2>
			<p class="customers-intro" data-reveal>
				Trusted by organizations across telecommunications, defense, and manufacturing.
			</p>
			<CustomerLogoGrid customers={customers} />
		</div>
	</section>

	<!-- Site-upgrade notice modal — homepage only. Closed by default in CSS;
	     the script below opens it unless "upgrade-notice-dismissed" is
	     already set in sessionStorage for this tab. -->
	<div class="upgrade-modal-overlay" id="upgrade-modal-overlay">
		<div
			class="upgrade-modal"
			id="upgrade-modal"
			role="dialog"
			aria-modal="true"
			aria-labelledby="upgrade-modal-title"
			aria-describedby="upgrade-modal-desc"
			tabindex="-1"
		>
			<span class="upgrade-modal-eyebrow">Site Notice</span>
			<h2 id="upgrade-modal-title">We're Upgrading Our Website</h2>
			<p id="upgrade-modal-desc">
				Cavotec Malaysia's website is currently being upgraded. We're in the process of migrating
				from our previous site to this new one, so some information may still be in progress.
				Thank you for your patience as we complete the transition.
			</p>
			<button type="button" class="btn btn-accent upgrade-modal-dismiss" id="upgrade-modal-dismiss">Got it</button>
		</div>
	</div>
</Layout>

<script>
	// Site-upgrade notice modal — homepage only, shown once per session
	// (sessionStorage, not localStorage: it should come back if the tab or
	// browser is closed and reopened, per the spec). Dismissing it also
	// reveals the persistent reminder bar rendered by Layout.astro — that
	// bar's own on-load check (in Layout.astro's script) is what makes it
	// keep showing automatically on every other page for the rest of the
	// session; this only needs to reveal it immediately on this page too,
	// without waiting for a reload.
	const UPGRADE_STORAGE_KEY = 'upgrade-notice-dismissed';

	function isUpgradeNoticeDismissed(): boolean {
		try {
			return sessionStorage.getItem(UPGRADE_STORAGE_KEY) === '1';
		} catch (e) {
			return false;
		}
	}

	function markUpgradeNoticeDismissed() {
		try {
			sessionStorage.setItem(UPGRADE_STORAGE_KEY, '1');
		} catch (e) {
			// sessionStorage unavailable (privacy mode, etc.) — the modal
			// will just show again next load in that case, which is an
			// acceptable degradation rather than a broken dismiss button.
		}
	}

	function getFocusableElements(container: HTMLElement): HTMLElement[] {
		return Array.from(
			container.querySelectorAll<HTMLElement>(
				'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'
			)
		);
	}

	// Hero background crossfade — cycles the stacked .hero-bg-image layers by
	// toggling `is-active` (the fade itself is a CSS transition, see below).
	// Reduced motion: leave the first image as the single static backdrop.
	// Off-screen: pause the interval rather than cycling unseen.
	class HeroBackgroundCycler {
		private images: HTMLElement[];
		private index = 0;
		private timer: number | null = null;
		private readonly intervalMs = 7000;

		constructor(root: HTMLElement) {
			this.images = Array.from(root.querySelectorAll<HTMLElement>('.hero-bg-image'));
		}

		private advance = () => {
			if (this.images.length < 2) return;
			this.images[this.index].classList.remove('is-active');
			this.index = (this.index + 1) % this.images.length;
			this.images[this.index].classList.add('is-active');
		};

		start() {
			if (this.timer !== null || this.images.length < 2) return;
			this.timer = window.setInterval(this.advance, this.intervalMs);
		}

		stop() {
			if (this.timer === null) return;
			window.clearInterval(this.timer);
			this.timer = null;
		}
	}

	// Hero background parallax — the oscilloscope-grid texture drifts a few
	// pixels toward the cursor (desktop) or device tilt (touch), eased with
	// a lerp so it reads as an ambient, instrument-panel-like response
	// rather than a flashy effect. Confined entirely to this decorative
	// layer: the heading/subtext/button live in .hero-inner, which this
	// class never touches, so they stay fixed and fully readable. Folds in
	// the same scroll-based drift Layout.astro's shared [data-parallax-bg]
	// gives every other page's header — .hero-grid deliberately opts out of
	// that attribute (see the markup above) so this class is the sole owner
	// of its transform instead of two scripts fighting over the property.
	class HeroParallax {
		private readonly hero: HTMLElement;
		private readonly grid: HTMLElement;
		private readonly maxOffset = 60; // px — pushed further again after 40px/0.5 still read as too subtle
		private readonly ease = 0.08; // lerp factor per frame toward the target
		private targetX = 0;
		private targetY = 0;
		private currentX = 0;
		private currentY = 0;
		private scrollOffsetY = 0;
		private rafId: number | null = null;
		private visible = true;
		private readonly controller = new AbortController();

		constructor(hero: HTMLElement, grid: HTMLElement) {
			this.hero = hero;
			this.grid = grid;
		}

		start() {
			const { signal } = this.controller;
			const supportsHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

			if (supportsHover) {
				this.hero.addEventListener('pointermove', this.handlePointerMove, { passive: true, signal });
				this.hero.addEventListener('pointerleave', this.handlePointerLeave, { passive: true, signal });
			} else if (typeof DeviceOrientationEvent !== 'undefined') {
				this.attachOrientation(signal);
			}
			// No hover-capable pointer and no orientation support: targetX/Y
			// simply never move, so the grid stays static — never an error.

			window.addEventListener('scroll', this.updateScrollOffset, { passive: true, signal });
			window.addEventListener('resize', this.updateScrollOffset, { passive: true, signal });
			this.updateScrollOffset();

			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							this.visible = entry.isIntersecting;
							if (this.visible) this.wake();
						}
					},
					{ threshold: 0 }
				);
				observer.observe(this.hero);
				signal.addEventListener('abort', () => observer.disconnect());
			}
		}

		destroy() {
			this.controller.abort();
			if (this.rafId !== null) cancelAnimationFrame(this.rafId);
			this.rafId = null;
		}

		private attachOrientation(signal: AbortSignal) {
			const requestPermission = (
				DeviceOrientationEvent as unknown as { requestPermission?: () => Promise<string> }
			).requestPermission;

			if (typeof requestPermission === 'function') {
				// iOS 13+ gates orientation behind an explicit permission grant,
				// which in turn normally requires an active user gesture to
				// resolve as "granted". There's no gesture here, so this either
				// silently succeeds (already granted) or rejects — either way
				// the grid just stays static instead of throwing.
				requestPermission()
					.then((state) => {
						if (state === 'granted') {
							window.addEventListener('deviceorientation', this.handleOrientation, { passive: true, signal });
						}
					})
					.catch(() => {});
			} else {
				window.addEventListener('deviceorientation', this.handleOrientation, { passive: true, signal });
			}
		}

		private clamp(value: number, min: number, max: number) {
			return Math.min(Math.max(value, min), max);
		}

		private handlePointerMove = (event: PointerEvent) => {
			const rect = this.hero.getBoundingClientRect();
			const relX = (event.clientX - rect.left) / rect.width - 0.5;
			const relY = (event.clientY - rect.top) / rect.height - 0.5;
			this.targetX = this.clamp(relX * this.maxOffset * 2, -this.maxOffset, this.maxOffset);
			this.targetY = this.clamp(relY * this.maxOffset * 2, -this.maxOffset, this.maxOffset);
			this.wake();
		};

		private handlePointerLeave = () => {
			this.targetX = 0;
			this.targetY = 0;
			this.wake();
		};

		private handleOrientation = (event: DeviceOrientationEvent) => {
			if (event.beta === null || event.gamma === null) return;
			const tiltX = this.clamp(event.gamma, -25, 25);
			const tiltY = this.clamp(event.beta - 45, -25, 25); // ~45° = phone held naturally, treated as centered
			this.targetX = (tiltX / 25) * this.maxOffset;
			this.targetY = (tiltY / 25) * this.maxOffset;
			this.wake();
		};

		private updateScrollOffset = () => {
			this.scrollOffsetY = this.hero.getBoundingClientRect().top * 0.12;
			this.wake();
		};

		private wake() {
			if (this.rafId === null && this.visible) {
				this.rafId = requestAnimationFrame(this.tick);
			}
		}

		private tick = () => {
			this.currentX += (this.targetX - this.currentX) * this.ease;
			this.currentY += (this.targetY - this.currentY) * this.ease;
			this.grid.style.transform = `translate3d(${this.currentX.toFixed(2)}px, ${(this.currentY + this.scrollOffsetY).toFixed(2)}px, 0)`;

			const settled = Math.abs(this.targetX - this.currentX) < 0.05 && Math.abs(this.targetY - this.currentY) < 0.05;

			if (this.visible && !settled) {
				this.rafId = requestAnimationFrame(this.tick);
			} else {
				this.rafId = null;
			}
		};
	}

	// ------------------------------------------------------------------
	// Homepage-only setup — everything below queries elements that live
	// inside <main> (the modal overlay, the hero section), which DOES get
	// replaced on every ClientRouter navigation, unlike Layout.astro's
	// persisted header/footer. Wrapped in its own function and re-run via
	// astro:page-load (fires once on the true initial load and again
	// after every subsequent transition) instead of running once at the
	// top of this script, which would only ever have applied to whichever
	// page happened to load first and silently done nothing on every
	// return visit to "/" after that.
	//
	// astro:page-load fires globally on every navigation site-wide, not
	// only while "/" is the active page, so this also runs (harmlessly)
	// when landing on any other page — every DOM query below returns
	// null/empty there and the guarded blocks just no-op, same as the
	// original top-level code already relied on before ClientRouter.
	// ------------------------------------------------------------------
	function initHomePage() {
		const upgradeModalOverlay = document.getElementById('upgrade-modal-overlay');
		const upgradeModal = document.getElementById('upgrade-modal');
		const upgradeModalDismiss = document.getElementById('upgrade-modal-dismiss');
		let upgradeModalPreviouslyFocused: HTMLElement | null = null;

		function onUpgradeModalKeydown(event: KeyboardEvent) {
			if (event.key === 'Escape') {
				event.preventDefault();
				closeUpgradeModal();
				return;
			}
			if (event.key !== 'Tab' || !upgradeModal) return;
			// Basic focus trap: with exactly one focusable element (the dismiss
			// button) this just keeps Tab/Shift+Tab from ever leaving it; with
			// more it wraps last→first and first→last.
			const focusable = getFocusableElements(upgradeModal);
			if (focusable.length === 0) {
				event.preventDefault();
				return;
			}
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		}

		function openUpgradeModal() {
			if (!upgradeModalOverlay || !upgradeModal) return;
			upgradeModalPreviouslyFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
			upgradeModalOverlay.classList.add('is-open');
			upgradeModal.focus();
			document.addEventListener('keydown', onUpgradeModalKeydown);
		}

		function closeUpgradeModal() {
			if (!upgradeModalOverlay) return;
			upgradeModalOverlay.classList.remove('is-open');
			document.removeEventListener('keydown', onUpgradeModalKeydown);
			markUpgradeNoticeDismissed();
			document.getElementById('upgrade-reminder-bar')?.classList.add('is-visible');
			upgradeModalPreviouslyFocused?.focus();
		}

		upgradeModalDismiss?.addEventListener('click', closeUpgradeModal);
		upgradeModalOverlay?.addEventListener('click', (event) => {
			if (event.target === upgradeModalOverlay) closeUpgradeModal();
		});

		if (!isUpgradeNoticeDismissed()) {
			openUpgradeModal();
		}

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const heroSection = document.querySelector<HTMLElement>('.hero');

		// Hero background crossfade.
		const heroBgRoot = document.querySelector<HTMLElement>('[data-hero-bg]');

		if (!prefersReducedMotion && heroSection && heroBgRoot) {
			const cycler = new HeroBackgroundCycler(heroBgRoot);

			if ('IntersectionObserver' in window) {
				const heroBgObserver = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								cycler.start();
							} else {
								cycler.stop();
							}
						}
					},
					{ threshold: 0 }
				);
				heroBgObserver.observe(heroSection);
				document.addEventListener('astro:before-swap', () => heroBgObserver.disconnect(), { once: true });
			} else {
				cycler.start();
			}
		}
		// If motion is reduced, .hero-bg-image:first-child keeps its server-
		// rendered `is-active` class and every other layer stays at opacity 0 —
		// a complete, valid static backdrop, no JS required.

		// Hero background parallax.
		const heroGridEl = document.querySelector<HTMLElement>('.hero-grid');

		if (!prefersReducedMotion && heroSection && heroGridEl) {
			const parallax = new HeroParallax(heroSection, heroGridEl);
			parallax.start();

			// Self-cleaning: HeroParallax owns its own AbortController, torn
			// down here on the next transition (astro:before-swap) or on a
			// genuine tab close/hide (pagehide) — either way, exactly once,
			// so scroll/resize/pointer listeners never accumulate across
			// repeated visits to "/".
			document.addEventListener('astro:before-swap', () => parallax.destroy(), { once: true });
			window.addEventListener('pagehide', () => parallax.destroy(), { once: true });
		}
		// If motion is reduced, .hero-grid keeps its default (untransformed)
		// position — fully static, exactly like every other page's
		// [data-parallax-bg] texture under reduced motion.
	}

	document.addEventListener('astro:page-load', initHomePage);
</script>

