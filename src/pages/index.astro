---
import Layout from '../layouts/Layout.astro';

const services = [
	{
		title: 'Test and Measurement Solutions',
		icon: 'gauge',
	},
	{
		title: 'Telecommunication Equipment',
		icon: 'tower',
	},
	{
		title: 'RF, Microwave & Radio Accessories',
		icon: 'signal',
	},
	{
		title: 'Test Equipment Repair, Calibration and Training',
		icon: 'wrench',
	},
	{
		title: 'Test Equipment Rental',
		icon: 'clock',
	},
];

// Build a seamless repeating sine-wave path for the hero's animated
// "signal" line. The pattern is drawn twice back to back (0–800 and
// 800–1600) so translating the rendered SVG by exactly half its width
// loops without a visible seam.
const SEGMENT_WIDTH = 40;
const SEGMENTS_PER_CYCLE = 20; // 20 * 40 = 800 units per repeat
const AMPLITUDE = 10;

function buildWaveSegment(offsetX) {
	let d = `M${offsetX},20`;
	for (let i = 0; i < SEGMENTS_PER_CYCLE; i++) {
		const x0 = offsetX + i * SEGMENT_WIDTH;
		const x1 = x0 + SEGMENT_WIDTH / 4;
		const x2 = x0 + (SEGMENT_WIDTH * 3) / 4;
		const x3 = x0 + SEGMENT_WIDTH;
		const cy = i % 2 === 0 ? 20 - AMPLITUDE : 20 + AMPLITUDE;
		d += ` C${x1},${cy} ${x2},${cy} ${x3},20`;
	}
	return d;
}

const signalWavePath = `${buildWaveSegment(0)} ${buildWaveSegment(800).replace(/^M[\d.]+,20/, 'L800,20')}`;

// "By the numbers" stats strip — general capability stats only, no
// certification/accreditation claims (those live on the Services page).
const stats = [
	{ value: '10+', label: 'Years of Technical Expertise' },
	{ value: '2,400+', label: 'Manufacturers Supported' },
	{ value: '5', label: 'Core Service Areas' },
	{ value: '24/7', label: 'Equipment Support Availability' },
];
---

<Layout
	title="Cavotec Malaysia Sdn Bhd — Test & Measurement Solutions"
	description="Cavotec Malaysia Sdn Bhd provides test and measurement solutions, telecommunication equipment, RF & microwave accessories, repair, calibration, training and rental services."
>
	<section class="hero">
		<div class="hero-grid" aria-hidden="true" data-parallax-bg></div>
		<div class="hero-inner">
			<div class="hero-layout">
				<div class="hero-content">
					<h1 data-reveal>Welcome to Cavotec Malaysia Sdn Bhd</h1>
					<p class="hero-subheading" data-reveal style="--reveal-i: 1;">
						Home for repair and services of your favorite test and measurement equipment
					</p>
					<a href="/services" class="btn btn-accent" data-reveal style="--reveal-i: 2;">Learn More</a>
				</div>

				<!-- Illustrative "live monitoring" readout — a visual accompaniment,
				     not real telemetry. The signal-wave lives inside it so the two
				     animated pieces read as one instrument rather than two separate
				     competing motions. Hidden from assistive tech: it's decorative
				     flavor, and auto-updating text without aria-live would be a
				     confusing announcement anyway. -->
				<div class="hero-readout" data-reveal style="--reveal-i: 3;" aria-hidden="true">
					<div class="hero-readout-ticks"></div>
					<div class="hero-readout-header">
						<span class="hero-readout-dot"></span>
						<span class="hero-readout-title">Live System Status</span>
					</div>

					<div class="signal-wave">
						<svg class="signal-wave-svg" viewBox="0 0 1600 40" preserveAspectRatio="none">
							<path d={signalWavePath} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
						</svg>
					</div>

					<ul class="hero-readout-rows">
						<li>
							<span class="row-label">Signal</span>
							<span class="row-value spec-mono" data-readout="signal">Stable</span>
						</li>
						<li>
							<span class="row-label">Status</span>
							<span class="row-value spec-mono" data-readout="status">Monitoring</span>
						</li>
						<li>
							<span class="row-label">Uptime</span>
							<span class="row-value spec-mono" data-readout="uptime">99.9%</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="stats-strip">
		<div class="stats-strip-inner">
			<span class="stats-eyebrow" data-reveal>By the Numbers</span>
			<ul class="stats-grid">
				{stats.map((stat, index) => (
					<li class="stat-item" data-reveal style={`--reveal-i: ${index + 1};`}>
						<span class="stat-number spec-mono" data-value={stat.value}>{stat.value}</span>
						<span class="stat-label">{stat.label}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="services">
		<div class="services-inner">
			<h2 data-reveal>List of Services Offered</h2>
			<div class="services-grid">
				{services.map((service, index) => (
					<div class="service-card tech-card" data-reveal style={`--reveal-i: ${index};`}>
						<span class="service-icon" aria-hidden="true">
							{service.icon === 'gauge' && (
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 21a9 9 0 1 0-9-9" />
									<path d="M12 21a9 9 0 0 0 9-9" />
									<path d="M12 12L16 8" />
									<circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none" />
								</svg>
							)}
							{service.icon === 'tower' && (
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 2l7 20M12 2L5 22" />
									<path d="M8.5 12h7M6.5 17h11" />
									<path d="M12 2v4" />
								</svg>
							)}
							{service.icon === 'signal' && (
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M4 12a8 8 0 0 1 16 0" />
									<path d="M7.5 12a4.5 4.5 0 0 1 9 0" />
									<circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none" />
									<path d="M12 13.3V19" />
								</svg>
							)}
							{service.icon === 'wrench' && (
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<path d="M14.7 6.3a4 4 0 0 0-5.4 4.6L4 16.2V20h3.8l5.3-5.3a4 4 0 0 0 4.6-5.4l-2.6 2.6-2-2 2.6-2.6z" />
								</svg>
							)}
							{service.icon === 'clock' && (
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="9" />
									<path d="M12 7v5l3.5 2" />
								</svg>
							)}
						</span>
						<h3>{service.title}</h3>
					</div>
				))}
			</div>
		</div>
	</section>

	<div class="tick-divider" aria-hidden="true"></div>

	<section class="closing-cta">
		<div class="closing-cta-grid" aria-hidden="true" data-parallax-bg></div>
		<div class="closing-cta-inner" data-reveal>
			<h2>Need High Quality Services? Call Us!</h2>
			<a href="/contact" class="btn btn-warm">Get in Touch</a>
		</div>
	</section>
</Layout>

<script>
	// "By the numbers" count-up. Follows the same intersection + reduced-motion
	// pattern as the scroll-reveal in Layout.astro: default to the final value
	// (server-rendered) so nothing ever gets stuck at 0, and only animate when
	// motion is allowed and the section actually scrolls into view.
	const statNumbers = document.querySelectorAll('.stat-number[data-value]');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function zeroState(value: string) {
		// Preserve everything but the leading digit run, e.g. "2,400+" -> "0+",
		// "24/7" -> "0/7", "5" -> "0".
		const match = value.match(/^([\d,]+)(.*)$/);
		if (!match) return value;
		return `0${match[2]}`;
	}

	function animateCount(el: Element) {
		const target = el.getAttribute('data-value') ?? '';
		const match = target.match(/^([\d,]+)(.*)$/);
		if (!match) return;
		const [, digits, suffix] = match;
		const endValue = parseInt(digits.replace(/,/g, ''), 10);
		const duration = 1400;
		const start = performance.now();

		function tick(now: number) {
			const progress = Math.min((now - start) / duration, 1);
			const eased = 1 - Math.pow(1 - progress, 3);
			const current = Math.round(endValue * eased);
			el.textContent = `${current.toLocaleString('en-US')}${suffix}`;
			if (progress < 1) {
				requestAnimationFrame(tick);
			} else {
				el.textContent = target;
			}
		}

		requestAnimationFrame(tick);
	}

	if (!prefersReducedMotion && 'IntersectionObserver' in window && statNumbers.length) {
		statNumbers.forEach((el) => {
			const value = el.getAttribute('data-value');
			if (value) el.textContent = zeroState(value);
		});

		const statsObserver = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						animateCount(entry.target);
						statsObserver.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.4 }
		);

		statNumbers.forEach((el) => statsObserver.observe(el));
	}
	// If motion is reduced or IntersectionObserver is unavailable, the
	// server-rendered final values (e.g. "10+") are left exactly as-is.

	// Hero "live system status" readout — purely illustrative, cycles through
	// a small set of representative (never alarming, never real) values on a
	// timer so the panel reads as "live" without being tied to any real data.
	const READOUT_VALUES: Record<string, string[]> = {
		signal: ['Stable', 'Optimal', 'Nominal'],
		status: ['Monitoring', 'Active', 'Online'],
		uptime: ['99.9%', '99.8%', '99.9%'],
	};
	const readoutRows = document.querySelectorAll<HTMLElement>('.hero-readout-rows [data-readout]');

	if (!prefersReducedMotion && readoutRows.length) {
		setInterval(() => {
			readoutRows.forEach((el) => {
				const key = el.getAttribute('data-readout');
				const options = key ? READOUT_VALUES[key] : undefined;
				if (!options) return;
				el.classList.add('is-updating');
				setTimeout(() => {
					const current = options.indexOf(el.textContent?.trim() ?? '');
					el.textContent = options[(current + 1) % options.length];
					el.classList.remove('is-updating');
				}, 220);
			});
		}, 2600);
	}
	// If motion is reduced, the rows stay exactly as server-rendered — a
	// complete, valid static state, never a half-updated flicker.
</script>

<style>
	section {
		width: 100%;
	}

	.btn {
		display: inline-block;
		padding: 0.85rem 2rem;
		border-radius: 4px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0.01em;
		transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
	}

	.btn-accent {
		background: var(--color-teal);
		color: var(--color-indigo);
		box-shadow: 0 6px 20px rgba(var(--color-teal-rgb), 0.35);
	}

	.btn-accent:hover,
	.btn-accent:focus-visible {
		background: #00d9eb;
		transform: translateY(-2px);
		box-shadow: 0 10px 26px rgba(var(--color-teal-rgb), 0.45);
	}

	/* Warm, customer-facing CTA — the one place amber takes the lead */
	.btn-warm {
		background: var(--color-amber);
		color: var(--color-indigo);
		box-shadow: 0 6px 20px rgba(var(--color-amber-rgb), 0.35);
	}

	.btn-warm:hover,
	.btn-warm:focus-visible {
		background: #ffb85e;
		transform: translateY(-2px);
		box-shadow: 0 10px 26px rgba(var(--color-amber-rgb), 0.45);
	}

	/* Hero */
	.hero {
		position: relative;
		background: linear-gradient(135deg, var(--color-indigo-dark) 0%, var(--color-indigo) 55%, var(--color-indigo-light) 100%);
		color: #ffffff;
		padding: 6.5rem 1.5rem;
		text-align: center;
		overflow: hidden;
		isolation: isolate;
	}

	/* Faint oscilloscope-style grid texture */
	.hero-grid {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			repeating-linear-gradient(90deg, rgba(var(--color-teal-rgb), 0.09) 0 1px, transparent 1px 48px),
			repeating-linear-gradient(0deg, rgba(var(--color-teal-rgb), 0.09) 0 1px, transparent 1px 48px);
		mask-image: radial-gradient(ellipse at center, black 15%, transparent 75%);
	}

	.hero-inner {
		max-width: 1100px;
		margin: 0 auto;
		position: relative;
	}

	.hero-layout {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 3rem;
	}

	.hero-content {
		flex: 1 1 380px;
		max-width: 620px;
	}

	.hero h1 {
		font-size: clamp(2rem, 4.5vw, 3rem);
		font-weight: 700;
		line-height: 1.2;
		margin: 0 0 1.25rem;
	}

	.hero-subheading {
		font-size: clamp(1rem, 2vw, 1.25rem);
		color: #cfdbe8;
		line-height: 1.6;
		margin: 0 0 2.25rem;
	}

	/* Animated signal-wave line — lives inside the readout panel so it and
	   the "live" data rows read as one instrument. */
	.signal-wave {
		width: 100%;
		height: 28px;
		margin: 0 0 1.1rem;
		overflow: hidden;
		color: var(--color-teal);
		opacity: 0.85;
	}

	.signal-wave-svg {
		display: block;
		width: 200%;
		height: 100%;
	}

	@media (prefers-reduced-motion: no-preference) {
		.signal-wave-svg {
			animation: signal-scroll 7s linear infinite;
		}
	}

	@keyframes signal-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	/* Hero "live system status" readout panel — instrument-readout styling
	   (dark panel, teal/mono text, tick-mark strip) matching the site's
	   tick-divider motif, scaled down. Illustrative only, not real data. */
	.hero-readout {
		flex: 0 1 300px;
		width: 100%;
		max-width: 300px;
		text-align: left;
		background: rgba(6, 18, 36, 0.55);
		border: 1px solid rgba(var(--color-teal-rgb), 0.3);
		border-radius: 10px;
		padding: 1.1rem 1.25rem 1.25rem;
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
	}

	.hero-readout-ticks {
		height: 10px;
		margin-bottom: 1rem;
		background-image:
			repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.14) 0, rgba(255, 255, 255, 0.14) 1px, transparent 1px, transparent 10px),
			repeating-linear-gradient(90deg, rgba(var(--color-teal-rgb), 0.6) 0, rgba(var(--color-teal-rgb), 0.6) 1.5px, transparent 1.5px, transparent 40px);
		background-repeat: repeat-x, repeat-x;
		background-position: center, center;
		background-size: auto 6px, auto 10px;
	}

	.hero-readout-header {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 1rem;
	}

	.hero-readout-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-teal);
		flex-shrink: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-readout-dot {
			animation: pulse-dot 2s ease-in-out infinite;
		}
	}

	@keyframes pulse-dot {
		0%,
		100% {
			opacity: 1;
			box-shadow: 0 0 0 0 rgba(var(--color-teal-rgb), 0.55);
		}
		50% {
			opacity: 0.7;
			box-shadow: 0 0 0 4px rgba(var(--color-teal-rgb), 0);
		}
	}

	.hero-readout-title {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-teal);
	}

	.hero-readout-rows {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.hero-readout-rows li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		font-size: 0.78rem;
	}

	.row-label {
		color: rgba(255, 255, 255, 0.5);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.row-value {
		color: var(--color-teal);
		font-weight: 600;
		transition: opacity 0.2s ease;
	}

	.row-value.is-updating {
		opacity: 0.2;
	}

	/* "By the numbers" stats strip — sits between the dark hero and the
	   white services section, so bg-alt keeps the light/dark rhythm going
	   without repeating either neighbor's background. */
	.stats-strip {
		background: var(--color-bg-alt);
		padding: 3.5rem 1.5rem;
	}

	.stats-strip-inner {
		max-width: 1100px;
		margin: 0 auto;
		text-align: center;
	}

	.stats-eyebrow {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-amber-dark);
		margin-bottom: 2rem;
	}

	.stats-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem 1.5rem;
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
	}

	.stat-number {
		font-size: clamp(2.1rem, 4.5vw, 2.9rem);
		font-weight: 600;
		line-height: 1;
		color: var(--color-teal-dark, #018b96);
	}

	.stat-label {
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		color: var(--color-indigo);
		max-width: 18ch;
	}

	/* Services */
	.services {
		background: var(--color-bg);
		padding: 5rem 1.5rem;
	}

	.services-inner {
		max-width: 1200px;
		margin: 0 auto;
	}

	.services h2 {
		text-align: center;
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		color: var(--color-indigo);
		margin: 0 0 3rem;
		position: relative;
	}

	.services h2::after {
		content: '';
		display: block;
		width: 64px;
		height: 3px;
		background: var(--color-teal);
		margin: 0.9rem auto 0;
		border-radius: 2px;
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.75rem;
	}

	.service-card {
		background: var(--color-bg);
		border: 1px solid var(--color-border, #e1e6ee);
		border-radius: 10px;
		padding: 2.25rem 1.5rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
	}

	.service-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: rgba(11, 30, 58, 0.06);
		color: var(--color-indigo);
		transition: background 0.25s ease, color 0.25s ease;
	}

	.service-card:hover .service-icon {
		background: var(--color-teal);
		color: var(--color-indigo);
	}

	.service-card h3 {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-text);
		margin: 0;
		line-height: 1.4;
	}

	/* Closing CTA */
	.closing-cta {
		position: relative;
		background: var(--color-indigo);
		color: #ffffff;
		padding: 4.5rem 1.5rem;
		text-align: center;
		overflow: hidden;
		isolation: isolate;
	}

	.closing-cta-grid {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: repeating-linear-gradient(90deg, rgba(var(--color-teal-rgb), 0.08) 0 1px, transparent 1px 48px);
		mask-image: linear-gradient(to bottom, black, transparent);
	}

	.closing-cta-inner {
		max-width: 640px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.75rem;
	}

	.closing-cta h2 {
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin: 0;
	}

	@media (max-width: 700px) {
		.stats-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 2.25rem 1.5rem;
		}
	}

	@media (max-width: 860px) {
		.hero-layout {
			flex-direction: column;
			gap: 2.25rem;
		}

		.hero-content {
			max-width: 620px;
		}

		.hero-readout {
			max-width: 340px;
		}
	}

	@media (max-width: 600px) {
		.hero {
			padding: 4.5rem 1.25rem;
		}

		.stats-strip,
		.services,
		.closing-cta {
			padding: 3.5rem 1.25rem;
		}

		.service-card {
			padding: 1.75rem 1.25rem;
		}
	}
</style>
